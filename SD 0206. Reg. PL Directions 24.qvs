// P&L მიმართულებებით: ДоходыИРасходы რეესტრი + Управленческий ჟურნალი (pl.txt-ის ლოგიკა),
// მატჩინგი Google Sheet-იდან, დინამიური განაწილება თვითღირებულების თვიური წილებით.
// მხოლოდ სრულ გადატვირთვაზე (24); ცხრილი ნაწილობრივ გადატვირთვებზე მეხსიერებაში რჩება.
if(not IsPartialReload()) then

Let vNow = Floor(now());

// P&L-ის მიმდინარე თვის მონაცემები 1C-ში ჯერ კიდევ მუშავდება; წინა თვეც მე-10 რიცხვამდე
// იხურება → ზედა ზღვარი (არაჩათვლით): თვის 1–9 რიცხვებში წინა თვის დასაწყისი (ბოლო ხილული
// თვე — ორი თვის წინანდელი), მე-10-დან — მიმდინარე თვის დასაწყისი (ბოლო ხილული თვე — წინა).
Let vPLEnd = Num(if(Day($(vNow)) < 10, MonthStart(AddMonths($(vNow),-1)), MonthStart($(vNow))));

// P&L-ის ქვედა ზღვარი: მიმდინარე + წინა წელი, ოღონდ 2026-ზე ადრე არასდროს.
// ორივე პირობა რჩება: 2026-ში — 2026/01/01, 2028-ში — 2027/01/01 (ე.ი. ფანჯარა ორ წელზე
// მეტი არ ხდება). იმავე ფორმულით შენდება კალენდრის [Year SD (ბოლო 2 წელი, 2026+)], რომ
// ფილტრი და მონაცემთა ფანჯარა ერთმანეთს დაემთხვეს.
// შეგნებულად ცალკე ცვლადია განყოფილების ზღვრისგან (vPLDeptFrom) — დღეს ერთი და იგივე
// თარიღია, მაგრამ მომავალში შეიძლება დაშორდნენ.
Let vPLStart = Num(RangeMax(YearStart(YearStart($(vNow))-1), MakeDate(2026,1,1)));

// 'Internal EEE' — ჯგუფის საკუთარი კომპანიები კონტრაგენტების მხარეს, 1C-ის კოდების სიით.
// განზრახ ცალკე დროშაა ჩვეულებრივი შიდა-კონტრაგენტის დროშისგან: ის კონტრაგენტის დამატებით
// რეკვიზიტს ეყრდნობა და უფრო ფართოა. სია აქ დგას, რომ ერთ ადგილას იცვლებოდეს.
SET vPLInternalEEE = 'G_-000931','G_-010539','G_-002484';

// განყოფილების ზღვარი — ᲧᲕᲔᲚᲐ ᲬᲧᲐᲠᲝᲡᲗᲕᲘᲡ (რეესტრი, ჟურნალი, გაყიდვები): 2026-მდე
// ᲡᲐᲩᲕᲔᲜᲔᲑᲔᲚ ველში განყოფილება არ ჩნდება. ᲛᲐᲢᲩᲘᲜᲒᲘᲡ ᲒᲐᲡᲐᲦᲔᲑᲡ ეს ᲐᲠ ᲔᲮᲔᲑᲐ —
// [_MatchKey (P&L)] განყოფილებას წლის მიუხედავად ინარჩუნებს, რომ განაწილება არ შეიცვალოს.
LET vPLDeptFrom = Num(MakeDate(2026,1,1));
SET vPLProjectSalesUnit = 'ELV_საპროექტო გაყიდვები';

// მატჩინგის ცხრილის მიმართულების სვეტები. ყველა სხვა სვეტი, რომლის სათაურიც Location-ფურცლის
// ლოკაციაა, საცალოს კალათაა (მიმართულება 'საცალო' + განყოფილება ლოკაციის სახელით); არც-არც —
// იგნორირდება (მაგ. [სულ]). ლოკაციის სვეტის სათაური ბაიტ-ბაიტ უნდა ემთხვეოდეს ლოკაციის
// სახელს — სხვაგვარად სვეტი ჩუმად იგნორირდება ან COGS-წილი 0 იქნება.
SET vPLMatchingDirections = 'დისტრიბუცია','კორპორატიული','ლოგისტიკა','ადმინისტრაცია';

// ბიუჯეტის (გეგმის) გაყიდვების ორი მუხლი — ინექციის ანალოგი გეგმაში: მატჩინგის ცხრილს
// გვერდს უვლიან და მიმართულებას ბიუჯეტის ცხრილის [მიმართულება] სვეტიდან იღებენ; ამასთან
// თვითღირებულების მუხლი დინამიური განაწილებისა და ლოგ/ადმ გადანაწილების ბაზას იძლევა.
// ᲧᲣᲠᲐᲓᲦᲔᲑᲐ: 'თვითირებულება' 1C-შივე ღ-ს გარეშე წერია — არ "გასწორდეს".
SET vPLBudgetSalesArticles = 'შემოსავალი რეალიზაციიდან','რეალიზებული პროდუქციის თვითირებულება';
SET vPLBudgetCogsArticle = 'რეალიზებული პროდუქციის თვითირებულება';

// რეესტრის/ჟურნალის მხარეს კონტრაგენტი არ არსებობს, ამიტომ იქ 'Internal EEE' ანგარიშით
// განისაზღვრება: დროშა ინთება, თუ გატარების ანგარიშის კოდი — ან მისი რომელიმე მშობლის კოდი —
// ამ სიაშია. სია ანგარიშთა გეგმის კოდებია (და არა მინიშნებები), რომ ცხრილთან შედარებადი იყოს.
SET vPLInternalEEEAccounts = 6150,8110/19,7231,7240,6170,7420/10,7420/11,8110/18,8110/15,8110/17,8413,7450/9,7450/12,8314,8192,5310,5400;

EEEКодыПЛ:
Load
    Trim(SubField('$(vPLInternalEEEAccounts)', ',')) as [%exists_EEE კოდი (P&L)]
AutoGenerate 1;

// ანგარიშთა გეგმის იერარქია კოდებით: გზა ფესვიდან კვანძამდე, '|'-ით გაერთიანებული.
// მშობლის სვეტი ამ ცნობარში [ექვემდებარება ანგარიშს]-ია (იხ. Accounting 0101).
EEEСчетаПЛPre:
Hierarchy([_EEE ანგარიში (P&L)], [_EEE ანგარიშის მშობელი (P&L)], [_EEE კოდი (P&L)], ,
    [_EEE კოდი (P&L)], [_EEE კოდების გზა (P&L)], '|')
LOAD
    [მინიშნება] as [_EEE ანგარიში (P&L)],
    if([ექვემდებარება ანგარიშს] = '00000000000000000000000000000000', Null(),
        [ექვემდებარება ანგარიშს]) as [_EEE ანგარიშის მშობელი (P&L)],
    Trim([ანგარიშის კოდი]) as [_EEE კოდი (P&L)]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_ПланСчетовУправленческий.qvd]
(qvd);

// გზა იშლება სტრიქონებად — თითო წინაპრის კოდი ცალკე სტრიქონად, რომ Exists-ით შემოწმდეს
EEEПутиПЛ:
Load
    [_EEE ანგარიში (P&L)],
    SubField([_EEE კოდების გზა (P&L)], '|') as [_EEE გზის კოდი (P&L)]
Resident EEEСчетаПЛPre;

Drop Table EEEСчетаПЛPre;

MapСчетаEEEПЛ:
Mapping Load Distinct
    [_EEE ანგარიში (P&L)],
    'კი'
Resident EEEПутиПЛ
Where Exists([%exists_EEE კოდი (P&L)], [_EEE გზის კოდი (P&L)]);

Drop Table EEEПутиПЛ;
Drop Table EEEКодыПЛ;

// სვეტების სახელები და ტიპების ლიტერალები გადამოწმებულია 1C-ის კონფიგურაციის დამპიდან
// (D:\Claude\nrg1c\src, 2026-07-22): ექსპორტიორი სვეტს არქმევს რეკვიზიტის სინონიმს (ObjectModule.bsl:759),
// Перечисление-ს მნიშვნელობებს — მნიშვნელობის სინონიმს (:867). სტანდარტული ველები რუსულად რჩება
// ([Период],[Регистратор] — დადასტურებულია არსებული QVD-ებით; [Активность] — იგივე ლოგიკით).

// ----- ანგარიშთა გეგმის რუკები: ყველა საჭირო რუკა უკვე შენდება 24-ის ჩართვის ჯაჭვში -----
// MapПеречислениеТипыСчетов — SD 0003; MapПланСчетовУправленческий (დასახელება) /
// …ТипСчета / …Код / …ВидСчетаPL — SD 0004, იმავე HLD_ELV_ПланСчетовУправленческий.qvd-დან
// ერთი ჩატვირთვით. მატჩინგის [მუხლი] = ანგარიშის ВидСчетаPL-ის დასახელება (Excel-ის სათაური:
// "მუხლი.P&&L ანგარიშის სახეობა"), და არა ანგარიშის საკუთარი დასახელება.

// მუხლების სორტირება 1C-ის რეპორტის მიხედვით: ყოველ დონეზე რიგითობით. ყოველ კვანძს
// უშენდება ნულებით შევსებული რიგითობების გზა ზემოდან ქვემოთ, გზით დალაგება იძლევა
// გლობალურ DFS რანგს. რანგი dual-ის რიცხვითი ნაწილია ყველა სახელში → ნებისმიერი
// ვიზუალიზაცია რიცხვითი (Auto) სორტირებით ზუსტად 1C-ის რიგს იმეორებს, გამოსახულების გარეშე.
// წაშლის ნიშნიანი (ПометкаУдаления) ელემენტები — 1C-ის დუბლიკატები — რანგში, იერარქიაში და
// ბიუჯეტის სახელი→GUID რუკაში არ შედიან (2026-08-03). GUID→სახელი რუკა კი უფილტროდ რჩება:
// ისტორიულმა გატარებებმა წაშლილ მუხლზეც უნდა შეინარჩუნონ სახელი.
МухлиСортПЛ:
Hierarchy([%lnk_მუხლი (P&L)], [_მუხლი მშობელი სორტ (P&L)], [_რიგითობა ელემენტი (P&L)], ,
    [_რიგითობა ელემენტი (P&L)], [_მუხლი sort (P&L)], '|')
LOAD
    [Ссылка] as [%lnk_მუხლი (P&L)],
    if([Родитель] = '00000000000000000000000000000000', Null(), [Родитель]) as [_მუხლი მშობელი სორტ (P&L)],
    Num(Alt([რიგითობა], 0), '0000000000') as [_რიგითობა ელემენტი (P&L)]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_СправочникВидыСчетовPL.qvd]
(qvd)
Where ApplyMap('MapБулево',[ПометкаУдаления],'არა') = 'არა';

МухлиРангПЛ:
NoConcatenate Load
    [%lnk_მუხლი (P&L)],
    [_მუხლი sort (P&L)],
    RowNo() as [_მუხლი რანგი (P&L)]
Resident МухлиСортПЛ
Order By [_მუხლი sort (P&L)];

Drop Table МухлиСортПЛ;

MapМухлиРангПЛ:
Mapping Load
    [%lnk_მუხლი (P&L)],
    [_მუხლი რანგი (P&L)]
Resident МухлиРангПЛ;

// ამ ცნობარს ქართული სინონიმები არ აქვს კონფიგურაციაში → სვეტები რუსულად რჩება.
// რუკა dual-ს აბრუნებს: ტექსტი — მუხლის სახელი, რიცხვი — იერარქიული რანგი სორტირებისთვის.
MapСправочникВидыСчетовPLПЛ:
Mapping LOAD
    [Ссылка],
    dual(Trim([Наименование]), ApplyMap('MapМухлиРангПЛ',[Ссылка],9999999));
LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_СправочникВидыСчетовPL.qvd]
(qvd);

// მუხლების იერარქია (ВидыСчетовPL: Родитель) — ფაქტს უკავშირდება [%lnk_მუხლი (P&L)]-ით
МухлиИерархияПЛ:
Hierarchy(
    [%lnk_მუხლი (P&L)],
    [_მუხლი მშობელი (P&L)],
    [მუხლი (იერარქია)],
    ,
    [მუხლი (იერარქია)],
    [მუხლი path (P&L)],
    ' > ',
    [მუხლი დონე (P&L)]
)
LOAD
    [Ссылка] as [%lnk_მუხლი (P&L)],
    if([Родитель] = '00000000000000000000000000000000', Null(), [Родитель]) as [_მუხლი მშობელი (P&L)],
    dual([Наименование], ApplyMap('MapМухлиРангПЛ',[Ссылка],9999999)) as [მუხლი (იერარქია)]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_СправочникВидыСчетовPL.qvd]
(qvd)
Where ApplyMap('MapБулево',[ПометкаУдаления],'არა') = 'არა';

// გზის ველი რჩება იერარქიის ცხრილში გადამოწმებისთვის/საჭიროებისას გამოსახულებით სორტირებისთვის
Left Join(МухлиИерархияПЛ)
Load
    [%lnk_მუხლი (P&L)],
    [_მუხლი sort (P&L)]
Resident МухлиРангПЛ;

Drop Table МухлиРангПЛ;

// ----- საქმიანობის მიმართულებების ანგარიშები (НаправленияДеятельности) -----
// 1C გაყიდვის შემოსავალს/თვითღირებულებას ნომენკლატურის საქმიანობის მიმართულების ამ ანგარიშებზე
// ატარებს (შიდა ოპერაციებს — ცალკე ანგარიშებზე). ამ ანგარიშებზე მდგარი რეესტრის/ჟურნალის
// სტრიქონები გამოირიცხება და მათ ნაცვლად გაყიდვების ფაქტიდან აწყობილი სტრიქონები ჩაჯდება
// (სკრიპტის ბოლო ბლოკები) — ჯამები ანგარიშების ჭრილში ემთხვევა, მიმართულება კი ჭეშმარიტია.
// ცარიელი მინიშნებები რუკებში არ ხვდება, რომ ApplyMap-ის default იმუშაოს.

НаправленияДеятельностиПЛPre:
LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_СправочникНаправленияДеятельности.qvd]
(qvd);

MapНаправлениеСчетВыручкиПЛ:
Mapping Load
    [მინიშნება],
    [შემოსავალი რეალიზაციიდან]
Resident НаправленияДеятельностиПЛPre
Where Len([შემოსავალი რეალიზაციიდან]) > 0 and not [შემოსავალი რეალიზაციიდან] = '00000000000000000000000000000000';

MapНаправлениеСчетВыручкиВнутрПЛ:
Mapping Load
    [მინიშნება],
    [შემოსავალი რეალიზაციიდან (შიდა ოპერაციები)]
Resident НаправленияДеятельностиПЛPre
Where Len([შემოსავალი რეალიზაციიდან (შიდა ოპერაციები)]) > 0 and not [შემოსავალი რეალიზაციიდან (შიდა ოპერაციები)] = '00000000000000000000000000000000';

MapНаправлениеСчетСебестоимостиПЛ:
Mapping Load
    [მინიშნება],
    [გაყიდვების თვითღირებულება]
Resident НаправленияДеятельностиПЛPre
Where Len([გაყიდვების თვითღირებულება]) > 0 and not [გაყიდვების თვითღირებულება] = '00000000000000000000000000000000';

MapНаправлениеСчетСебестоимостиВнутрПЛ:
Mapping Load
    [მინიშნება],
    [გაყიდვების თვითღირებულება (შიდა ოპერაციები)]
Resident НаправленияДеятельностиПЛPre
Where Len([გაყიდვების თვითღირებულება (შიდა ოპერაციები)]) > 0 and not [გაყიდვების თვითღირებულება (შიდა ოპერაციები)] = '00000000000000000000000000000000';

// გამოსაცვლელი (ანგარიში|რეგისტრატორი) წყვილები ქვემოთ შენდება გაყიდვების ფაქტიდან (СчетаРегистраторыИзПродажПЛ):
// რეესტრის/ჟურნალის სტრიქონები მხოლოდ იმ ანგარიში+რეგისტრატორის კომბინაციებში იცვლება, სადაც გაყიდვების
// ფაქტს რეალურად აქვს მონაცემი. აქტიურია შემოსავალიც და თვითღირებულებაც — ორივე მხოლოდ
// ჩვეულებრივი ანგარიშებით (შიდა ოპერაციების ვარიანტები არა).
Drop Table НаправленияДеятельностиПЛPre;

// ----- განყოფილების გადაფარვა ანგარიშის მიხედვით (pl.txt ეტაპი 3: ПодразделенияЗатратДоходовСчетов) -----

MapПодразделенияЗатратДоходовСчетовПЛ:
Mapping LOAD
    [ორგანიზაცია] & '|' & [ანგარიში],
    [შემოსავლების/ხარჯების განყოფილება]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_РегистрСведенийПодразделенияЗатратДоходовСчетов.qvd]
(qvd);

// ----- განყოფილება → ლოკაცია (Qlik Matching, Location ფურცელი) -----
// ნორმალიზებული სახელის ᲖᲔᲛᲝᲓᲐᲜ ედება საჩვენებელ ერთეულსა და საცალოს COGS-კალათებზე:
// დისტრიბუციის/საპროექტო განყოფილებები ფილიალის ლოკაციაში იყრება.
// ᲛᲐᲢᲩᲘᲜᲒᲘᲡ ᲒᲐᲡᲐᲦᲔᲑᲡ ᲓᲐ ᲡᲐᲬᲧᲘᲡ ᲕᲔᲚᲡ ᲐᲠ ᲔᲮᲔᲑᲐ — ორივე ლოკაციამდელ ნორმალიზებულ
// სახელზე რჩება, რომ PL Directions ცხრილი ამ სახელებით განაგრძობდეს მატჩინგს.
// ცხრილში უცნობი სახელი რუკაში უცვლელად გადის (default არ სჭირდება).
ЛокацииПЛPre:
Load
    Trim([განყოფილება]) as [_ლოკ განყოფილება (P&L)],
    Trim([ლოკაცია]) as [_ლოკ ლოკაცია (P&L)];
SELECT [განყოფილება],
    [ლოკაცია]
FROM GetWorksheetV2
WITH PROPERTIES (
worksheetKey='1khHxo_6tF2-fj0BWu77QLWC9ODRZOnw4DMteglpaYZc:_2024957535', //Qlik Matching, Location Sheet
gidOverride='',
generatedNumberedColumns='false',
skipRows=''
);

MapЛокацияПодразделенияПЛ:
Mapping Load
    [_ლოკ განყოფილება (P&L)],
    [_ლოკ ლოკაცია (P&L)]
Resident ЛокацииПЛPre;

// ლოკაციების სია — მატჩინგის ცხრილის სვეტები ამით კლასიფიცირდება: ლოკაციის სვეტი →
// საცალოს კალათა. ცხრილი НаборыПЛPre-ს შემდეგ იშლება.
ЛокацииПЛ:
Load Distinct
    [_ლოკ ლოკაცია (P&L)] as [%exists_ლოკაცია (P&L)]
Resident ЛокацииПЛPre;

Drop Table ЛокацииПЛPre;

// ----- მატჩინგის ცხრილი Google Sheet-იდან (matching.xlsx-ის შიგთავსი) -----
// სვეტები: [მუხლი], [სტრუქტურული ერთეული], შემდეგ 7 სამიზნე სვეტი: 3 მაღაზია + დისტრიბუცია,
// კორპორატიული, ლოგისტიკა, ადმინისტრაცია. უჯრა: რიცხვი = ფიქსირებული პროცენტი, 'დინამიურად' =
// COGS-ის წილებით ᲛᲝᲜᲘᲨᲜᲣᲚ სვეტებს შორის. ერთ სტრიქონზე ორივის შერევა დასაშვებია: რიცხვები
// თავიანთ პროცენტს იღებენ, ნაშთი (1 − ჯამი) დინამიურ სვეტებზე ნაწილდება (წესები ქვემოთ, КлючиПЛ-ზე).
// [სულ] სვეტი შეგნებულად არ იტვირთება (საკონტროლო თანხაა).

MatchingPLPre:
// სვეტები იტვირთება ავტომატურად (LOAD *) — ახალი ლოკაციის სვეტი სკრიპტის ცვლილებას არ
// საჭიროებს. პირველი 2 სვეტი ([მუხლი], [სტრუქტურული ერთეული]) Crosstable-ის საკვალიფიკაციოა —
// მათი ადგილი ცხრილში არ შეიცვალოს.
Crosstable([მიმართულება (Matching)], [წონა (Matching)], 2)
LOAD *;
SELECT *
FROM GetWorksheetV2
WITH PROPERTIES (
worksheetKey='1khHxo_6tF2-fj0BWu77QLWC9ODRZOnw4DMteglpaYZc:_1471319728', //Qlik Matching, PL Directions Sheet
gidOverride='',
generatedNumberedColumns='false',
skipRows=''
);

// ----- უჯრების გაშლა საბოლოო კალათებად: სვეტი → (მიმართულება, განყოფილება) -----
// ლოკაციის სვეტი (Location-ფურცლის ლოკაცია) = 'საცალო' + განყოფილება ლოკაციის სახელით;
// მიმართულების სვეტი ($(vPLMatchingDirections)) = მიმართულება, ცარიელი განყოფილებით;
// ყველა სხვა სვეტი ([სულ] და მისთ.) იგნორირდება. განაწილება ერთ ტალღად ხდება პირდაპირ
// ამ კალათებში — მიმართულების შიგნით განყოფილებების მეორე ფენა არ არსებობს.
НаборыПЛPre:
NoConcatenate Load
    Trim([მუხლი]) & '|' & Trim([სტრუქტურული ერთეული]) as [_MatchKey (P&L)],
    if(Exists([%exists_ლოკაცია (P&L)], [მიმართულება (Matching)]), 'საცალო',
        [მიმართულება (Matching)]) as [_სამიზნე მიმართულება (P&L)],
    if(Exists([%exists_ლოკაცია (P&L)], [მიმართულება (Matching)]),
        [მიმართულება (Matching)], '') as [_სამიზნე ერთეული (P&L)],
    if(IsNum([წონა (Matching)]) and Num([წონა (Matching)]) > 0,
        Num([წონა (Matching)]), Null()) as [_წონა რიცხვი (P&L)],
    if(Trim([წონა (Matching)]) = 'დინამიურად', 1, 0) as [_დინამ მარკერი (P&L)]
Resident MatchingPLPre
Where ((IsNum([წონა (Matching)]) and Num([წონა (Matching)]) > 0)
    or Trim([წონა (Matching)]) = 'დინამიურად')
    and (Exists([%exists_ლოკაცია (P&L)], [მიმართულება (Matching)])
        or match([მიმართულება (Matching)], $(vPLMatchingDirections)) > 0);

Drop Tables MatchingPLPre, ЛокацииПЛ;

// გასაღების დონის აგრეგატები: რიცხვების ჯამი/რაოდენობა და დინამიური მონიშვნების რაოდენობა
Left Join(НаборыПЛPre)
Load
    [_MatchKey (P&L)],
    Sum([_წონა რიცხვი (P&L)]) as [_ფიქს ჯამი (P&L)],
    Count([_წონა რიცხვი (P&L)]) as [_ფიქს რაოდენობა (P&L)],
    Sum([_დინამ მარკერი (P&L)]) as [_დინამ რაოდენობა (P&L)]
Resident НаборыПЛPre
Group By [_MatchKey (P&L)];

// გასაღების წესები:
// - მხოლოდ რიცხვები: წილები ნორმალიზდება გასაღების ჯამზე (60/40 მუშაობს; მარტოხელა 60%-იც
//   მთლიანად თავის სვეტზე მიდის); ჯამი ≠ 100% → დროშა 'არა'.
// - რიცხვები + 'დინამიურად' (შერეული): რიცხვები ᲐᲑᲡᲝᲚᲣᲢᲣᲠᲘ პროცენტებია, ნაშთი (1 − ჯამი)
//   მონიშნულ სვეტებზე ნაწილდება COGS-ით; ჯამი ≥ 100% → რიცხვები ნორმალიზდება, დინამიური
//   ნაწილი 0, დროშა 'არა'.
// - მხოლოდ 'დინამიურად': მთელი თანხა მონიშნულ სვეტებს შორის COGS-ის წილებით.
КлючиПЛ:
NoConcatenate Load Distinct
    [_MatchKey (P&L)],
    [_ფიქს ჯამი (P&L)],
    [_ფიქს რაოდენობა (P&L)],
    [_დინამ რაოდენობა (P&L)],
    if([_ფიქს რაოდენობა (P&L)] = 0, 1,
        RangeMax(1 - [_ფიქს ჯამი (P&L)], 0)) as [_დინამ ნაშთი (P&L)]
Resident НаборыПЛPre;

// მარკერები შტოების Where-პირობებისთვის: გასაღებს აქვს ფიქსირებული ნაწილი / აქტიური
// დინამიური ნაწილი / საერთოდ არის ცხრილში. შერეული გასაღები ორივე შტოში ჩნდება —
// წილები ურთიერთშემავსებელია და ჯამში 1-ს იძლევა.
MapКлючФиксПЛ:
Mapping Load Distinct
    [_MatchKey (P&L)],
    1
Resident КлючиПЛ
Where [_ფიქს რაოდენობა (P&L)] > 0;

MapКлючДинамПЛ:
Mapping Load Distinct
    [_MatchKey (P&L)],
    1
Resident КлючиПЛ
Where [_დინამ რაოდენობა (P&L)] > 0 and [_დინამ ნაშთი (P&L)] > 0;

MapКлючМатчПЛ:
Mapping Load Distinct
    [_MatchKey (P&L)],
    1
Resident КлючиПЛ;

// დინამიური ნაწილის ზომა გასაღებზე (1 − რიცხვების ჯამი; ურიცხვო გასაღებზე 1)
MapДинамОстатокПЛ:
Mapping Load Distinct
    [_MatchKey (P&L)],
    [_დინამ ნაშთი (P&L)]
Resident КлючиПЛ;

// დისბალანსი იკარგება არა თანხაში, არამედ აისახება დროშაში [წილები დაბალანსებულია (P&L)] =
// 'არა' → შესამოწმებელ ფურცელზე ჩანს ყველა გასასწორებელი სტრიქონი.
MapБалансДолейПЛ:
Mapping Load Distinct
    [_MatchKey (P&L)],
    if([_დინამ რაოდენობა (P&L)] = 0,
        if(Round([_ფიქს ჯამი (P&L)],0.0001) = 1, 'კი', 'არა'),
        if([_ფიქს რაოდენობა (P&L)] = 0 or Round([_ფიქს ჯამი (P&L)],0.0001) < 1, 'კი', 'არა'))
Resident КлючиПЛ;

Drop Table КлючиПЛ;

// ----- ფიქსირებული ნაწილი: თითო რიცხვიან უჯრაზე თითო კალათა -----
// წილი: შერეულ სტრიქონზე (დინამიურიც მონიშნულია და ჯამი < 100%) რიცხვი აბსოლუტურია,
// სხვა შემთხვევაში — ნორმალიზებული გასაღების ჯამზე. თანხა ყოველთვის სრულად ნაწილდება.
ФиксДолиПЛ:
NoConcatenate Load
    [_MatchKey (P&L)],
    [_სამიზნე მიმართულება (P&L)] as [_ფიქს მიმართულება (P&L)],
    [_სამიზნე ერთეული (P&L)] as [_ფიქს ერთეული (P&L)],
    if([_დინამ რაოდენობა (P&L)] > 0 and Round([_ფიქს ჯამი (P&L)],0.0001) < 1,
        [_წონა რიცხვი (P&L)],
        [_წონა რიცხვი (P&L)] / [_ფიქს ჯამი (P&L)]) as [_ფიქს წილი (P&L)]
Resident НаборыПЛPre
Where [_წონა რიცხვი (P&L)] > 0;

// 'დინამიურად' მონიშნული კალათები გასაღების ჭრილში — ცხრილად და არა რუკად, რომ ინახებოდეს,
// ᲠᲝᲛᲔᲚ სვეტში იდგა მონიშვნა (ქვესიმრავლეზე განაწილებას სწორედ ეს სჭირდება)
ДинамНаправленияПЛ:
NoConcatenate Load
    [_MatchKey (P&L)] as [_დინამ გასაღები (P&L)],
    [_სამიზნე მიმართულება (P&L)] as [_დინამ მიმართულება (P&L)],
    [_სამიზნე ერთეული (P&L)] as [_დინამ ერთეული (P&L)]
Resident НаборыПЛPre
Where [_დინამ მარკერი (P&L)] = 1;

Drop Table НаборыПЛPre;

// ----- თვითღირებულების თვიური წილები დინამიური განაწილებისთვის (თვე × მიმართულება, ჯამურად 3 ორგანიზაციაზე) -----
// გეგმის სტრიქონები ('გეგმა') გამორიცხულია; წილები ფიქსირდება დღეში ერთხელ, სრულ გადატვირთვაზე.
// წილებში მონაწილეობს მხოლოდ ძირითადი ნომენკლატურა და არაშიდა კონტრაგენტები —
// იგივე გამორიცხვები, რაც აპის $(შიდა_და_არაძითადები_ფილტრი) ცვლადში.

MapНеОсновнойПЛ:
Mapping Load
    [მინიშნება],
    ApplyMap('MapБулево',[არ არის ძირითადი],'არა')
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникНоменклатура.qvd]
(qvd);

// ნომენკლატურა → საქმიანობის მიმართულება (GUID) — გაყიდვების ინექციაში ანგარიშის დასადგენად
MapНоменклатураНаправлениеПЛ:
Mapping Load
    [მინიშნება],
    [საქმიანობის მიმართულება]
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникНоменклатура.qvd]
(qvd);

// ----- გაყიდვების ინექციის მასალა + გამოსაცვლელი (ანგარიში|რეგისტრატორი) წყვილები -----
// წინასწარ შენდება, რომ ქვემოთ ПЛСтейджинг2-ის გამორიცხვამ გამოიყენოს: რეესტრი/ჟურნალი მხოლოდ
// იმ ანგარიში+რეგისტრატორის კომბინაციებში იცვლება, სადაც გაყიდვების ფაქტს მონაცემი აქვს.
// თვით ინექცია სკრიპტის ბოლოშია (ცხრილი ПродажиДляПЛ იქამდე რჩება).
ПродажиДляПЛ:
NoConcatenate Load
    SalesDate,
    [%lnk_ორგანიზაცია (გაყიდვები)] as [_ორგანიზაცია (P&L გაყიდვები)],
    [%lnk_რეგისტრატორი (გაყიდვები)] as [_რეგისტრატორი (P&L გაყიდვები)],
    // მიმართულების წესი: რეალური მიმართულება ენიჭება მხოლოდ არაშიდა კონტრაგენტის და ძირითადი
    // ნომენკლატურის გაყიდვებს, რომლებსაც გაყიდვებში მიმართულება უწერიათ; ყველა დანარჩენი
    // (შიდა, არაძირითადი, უმიმართულებოც) — 'ლოგისტიკა'. თანხობრივად ყველა სტრიქონი შედის.
    if(ApplyMap('MapСправочникКонтрагентыДополнительныеРеквизитыInternal',[%lnk_კონტრაგენტი (გაყიდვები)],'არა') = 'არა'
        and ApplyMap('MapНеОсновнойПЛ',[%lnk_ნომენკლატურა (გაყიდვები)],'არა') = 'არა'
        and Len(Trim([მიმართულება (გაყიდვები)])) > 0
        and not [მიმართულება (გაყიდვები)] = 'მიმართულების გარეშე',
        [მიმართულება (გაყიდვები)],
        'ლოგისტიკა'
    ) as [_მიმართულება (P&L გაყიდვები)],
    // ნედლი (წესამდელი) მიმართულება ცალკე ველად — ფაქტში [მიმართულება (P&L, საწყისი)] ხდება
    // (მხოლოდ გაყიდვების წყაროზე), რომ ნედლი მონაცემების ჭრილში საწყისი მნიშვნელობა ჩანდეს.
    [მიმართულება (გაყიდვები)] as [_მიმართულება საწყისი (P&L გაყიდვები)],
    // ორივე ატრიბუტი ინახება ცალკე ველებად (და არა მხოლოდ ზემოთა if-ში), რომ გაყიდვებიდან
    // ინექცირებული სტრიქონები აპში იმავე ჭრილში გაიფილტროს, როგორც გაყიდვების ფურცლები —
    // ჰარდკოდირებული გამორიცხვის ნაცვლად მომხმარებელი თავად ფილტრავს.
    ApplyMap('MapСправочникКонтрагентыДополнительныеРеквизитыInternal',[%lnk_კონტრაგენტი (გაყიდვები)],'არა') as [_Internal (P&L გაყიდვები)],
    ApplyMap('MapНеОсновнойПЛ',[%lnk_ნომენკლატურა (გაყიდვები)],'არა') as [_არაძირითადი (P&L გაყიდვები)],
    if(match(ApplyMap('MapСправочникКонтрагентыКод',[%lnk_კონტრაგენტი (გაყიდვები)],''),
        $(vPLInternalEEE)) > 0, 'კი', 'არა') as [_Internal EEE (P&L გაყიდვები)],
    // განყოფილება 1C-ის წესით: თუ შეკვეთის გაყიდვის სტრუქტურული ერთეული საპროექტო
    // გაყიდვებია, მაშინ ის; თორემ დოკუმენტის განყოფილება. აქ წლის ზღვარი ᲐᲠ ედება —
    // ისევე როგორც რეესტრზე/ჟურნალზე, 2026-ის ზღვარი მხოლოდ საჩვენებელ ველს ედება,
    // ინექციის ბლოკებში ქვემოთ; ნორმალიზება (2026-08-03) კი ორივე ველზეა, წლის ზღვრის
    // გარეშე. საწყისი მნიშვნელობა ყველა წელს რჩება.
    if(ApplyMap('MapСправочникСтруктурныеЕдиницы',
            ApplyMap('MapЗаказЕдиницаПродажиПЛ',
                ApplyMap('MapДокументЗаказПЛ',[%lnk_დოკუმენტი (გაყიდვები)],''),''),'')
        = '$(vPLProjectSalesUnit)',
        ApplyMap('MapЗаказЕдиницаПродажиПЛ',
            ApplyMap('MapДокументЗаказПЛ',[%lnk_დოკუმენტი (გაყიდვები)],''),''),
        ApplyMap('MapДокументПодразделениеПЛ',[%lnk_დოკუმენტი (გაყიდვები)],'')) as [_ერთეული (P&L გაყიდვები)],
    ApplyMap('MapНаправлениеСчетВыручкиПЛ', ApplyMap('MapНоменклатураНаправлениеПЛ',[%lnk_ნომენკლატურა (გაყიდვები)],Null()), Null()) as [_შემოსავლის ანგარიში (P&L)],
    ApplyMap('MapНаправлениеСчетСебестоимостиПЛ', ApplyMap('MapНоменклатураНаправлениеПЛ',[%lnk_ნომენკლატურა (გაყიდვები)],Null()), Null()) as [_თვითღირებულების ანგარიში (P&L)],
    [თანხა (გაყიდვები)] as [_თანხა (P&L გაყიდვები)],
    [თვითღირებულება (გაყიდვები)] as [_თვითღირებულება (P&L გაყიდვები)]
Resident РегистрНакопленияПродажи
Where not [%lnk_ორგანიზაცია (გაყიდვები)] = 'გეგმა'
    and SalesDate >= $(vPLStart)
    and SalesDate < $(vPLEnd);

// შემოსავლისა და თვითღირებულების (ანგარიში|რეგისტრატორი) წყვილები:
СчетаРегистраторыИзПродажПЛ:
Load Distinct
    [_შემოსავლის ანგარიში (P&L)] & '|' & [_რეგისტრატორი (P&L გაყიდვები)] as [%exists_СчетРегистратор (P&L)]
Resident ПродажиДляПЛ
Where Len([_შემოსავლის ანგარიში (P&L)]) > 0;

// თვითღირებულების (ანგარიში|რეგისტრატორი) წყვილებიც აქტიურია — მხოლოდ ჩვეულებრივი ანგარიში, შიდა ვარიანტი არა
Concatenate(СчетаРегистраторыИзПродажПЛ)
Load Distinct
    [_თვითღირებულების ანგარიში (P&L)] & '|' & [_რეგისტრატორი (P&L გაყიდვები)] as [%exists_СчетРегистратор (P&L)]
Resident ПродажиДляПЛ
Where Len([_თვითღირებულების ანგარიში (P&L)]) > 0;

// წილები ითვლება ПродажиДляПЛ-იდან და არა პირდაპირ გაყიდვების ფაქტიდან, რომ განყოფილება
// ზუსტად იგივე ლოგიკით მოვიდეს, რითიც ინექცირებულ სტრიქონებში (ერთი განსაზღვრება).
// ბაზის კალათები: დისტრიბუცია და კორპორატიული მიმართულების დონეზე (ცარიელი განყოფილებით) +
// საცალო ლოკაციების ჭრილში — ᲧᲕᲔᲚᲐ ლოკაცია, რომელსაც COGS აქვს (ცარიელი ლოკაციის
// სტრიქონები ბაზიდან ვარდება).
// შიდა/არაძირითადი და უმიმართულებო სტრიქონები 'ლოგისტიკა'-ზე გადადიან, ე.ი. ფილტრი ისედაც
// ამოაგდებს მათ; 'გეგმა' და თარიღის ზღვრები ПродажиДляПЛ-შივეა.
// ᲧᲣᲠᲐᲓᲦᲔᲑᲐ: ПродажиДляПЛ-ის [_ერთეული (P&L გაყიდვები)] ᲛᲘᲜᲘᲨᲜᲔᲑᲐᲐ (GUID) და არა სახელი.
// საცალოს კალათა ᲚᲝᲙᲐᲪᲘᲘᲡ სახელზე შენდება (ნორმალიზება + ლოკაცია): ერთ ლოკაციაში
// ჩაყრილი განყოფილებები განაწილებისთვის ერთია, და სწორედ ლოკაციის სახელი უნდა ედგას
// ცხრილის სვეტს სათაურად.
ДолиСебестоимостиPre:
Load
    [_თვე (P&L)],
    [_მიმართულება (P&L წილი)],
    [_ერთეული (P&L წილი)],
    sum([_COGS ნედლი (P&L)]) as [_COGS (P&L)]
Group by
    [_თვე (P&L)],
    [_მიმართულება (P&L წილი)],
    [_ერთეული (P&L წილი)];
Load
    MonthStart(SalesDate) as [_თვე (P&L)],
    [_მიმართულება (P&L გაყიდვები)] as [_მიმართულება (P&L წილი)],
    // მაღაზიის კალათა ლოკაციის დონეზეა — ლოკაციაში ჩაყრილი განყოფილების COGS-იც
    // კალათაში ხვდება (3 მაღაზია საკუთარ თავზეა დარუკული).
    if([_მიმართულება (P&L გაყიდვები)] = 'საცალო',
        ApplyMap('MapЛокацияПодразделенияПЛ',
            ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')),
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')))),
        '') as [_ერთეული (P&L წილი)],
    [_თვითღირებულება (P&L გაყიდვები)] as [_COGS ნედლი (P&L)]
Resident ПродажиДляПЛ
Where match([_მიმართულება (P&L გაყიდვები)],'დისტრიბუცია','კორპორატიული')
    or ([_მიმართულება (P&L გაყიდვები)] = 'საცალო'
        and Len(Trim(ApplyMap('MapЛокацияПодразделенияПЛ',
            ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')),
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')))))) > 0);

// თვის მთლიანი ჯამი — წილი კალათებზე ისე ჯამდება, რომ თვეში ყოველთვის 1-ს იძლევა
// (ჯამი მხოლოდ ბაზაში შემავალ კალათებზეა)
Left Join(ДолиСебестоимостиPre)
Load
    [_თვე (P&L)],
    sum([_COGS (P&L)]) as [_COGS სულ (P&L)]
Resident ДолиСебестоимостиPre
Group by [_თვე (P&L)];

ДолиСебестоимости:
NoConcatenate Load
    [_თვე (P&L)],
    [_მიმართულება (P&L წილი)],
    [_ერთეული (P&L წილი)],
    if([_COGS სულ (P&L)] > 0, [_COGS (P&L)] / [_COGS სულ (P&L)], 0) as [_წილი (P&L)]
Resident ДолиСебестоимостиPre;

Drop Table ДолиСебестоимостиPre;

// გადანაწილების ვარიანტებისთვის წილების ცალკე ასლი გადარქმეული ველებით — ორიგინალი ქვემოთ
// უპოვარი გასაღებების განაწილებას სჭირდება და იქვე იშლება. ნულოვანი წილები აქ გამოირიცხება:
// უწილო ან ნულოვანი ჯამური თვითღირებულების თვის თანხა fallback-ით წყაროს მიმართულებაზე რჩება
// (წილით 1), რომ ჯამი არ დაიკარგოს (გაშლის ბლოკი სკრიპტის ბოლოშია).
ДолиДляАллокацииПЛ:
NoConcatenate Load
    [_თვე (P&L)] as [_ალოკ თვე (P&L)],
    [_მიმართულება (P&L წილი)] as [_ალოკ მიმართულება (P&L)],
    [_ერთეული (P&L წილი)] as [_ალოკ ერთეული (P&L)],
    [_წილი (P&L)] as [_ალოკ წილი (P&L)]
Resident ДолиСебестоимости
Where [_წილი (P&L)] > 0;

// ----- 'დინამიურად' მონიშნული კალათების წილები გასაღების ჭრილში -----
// მონიშნულ კალათებზე თვის წილები ჯამდება და ნორმალიზდება, რომ 'დინამიურად' მხოლოდ
// ᲛᲝᲜᲘᲨᲜᲣᲚᲔᲑᲡ შორის ანაწილებდეს. თვე, სადაც არცერთ მონიშნულ კალათას წილი არ აქვს,
// ცხრილში ვერ ხვდება → ის თანხა ქვემოთ 'მიმართულების გარეშე' რჩება მთლიანად.
// ლოგისტიკა/ადმინისტრაცია ბაზაში არ არსებობს, ამიტომ იქ დასმული მონიშვნა არაფერს იძლევა.
ДинамДолиПЛ:
NoConcatenate Load
    [_დინამ გასაღები (P&L)],
    [_დინამ მიმართულება (P&L)],
    [_დინამ ერთეული (P&L)]
Resident ДинамНаправленияПЛ;

Left Join(ДинамДолиПЛ)
Load
    [_მიმართულება (P&L წილი)] as [_დინამ მიმართულება (P&L)],
    [_ერთეული (P&L წილი)] as [_დინამ ერთეული (P&L)],
    [_თვე (P&L)] as [_დინამ თვე (P&L)],
    [_წილი (P&L)] as [_დინამ წილი (P&L)]
Resident ДолиСебестоимости
Where [_წილი (P&L)] > 0;

Left Join(ДинамДолиПЛ)
Load
    [_დინამ გასაღები (P&L)],
    [_დინამ თვე (P&L)],
    Sum([_დინამ წილი (P&L)]) as [_დინამ ჯამი (P&L)]
Resident ДинамДолиПЛ
Group By [_დინამ გასაღები (P&L)], [_დინამ თვე (P&L)];

ДинамДолиНормПЛ:
NoConcatenate Load
    [_დინამ გასაღები (P&L)],
    [_დინამ თვე (P&L)],
    [_დინამ მიმართულება (P&L)],
    [_დინამ ერთეული (P&L)],
    [_დინამ წილი (P&L)] / [_დინამ ჯამი (P&L)] as [_დინამ ნორმ წილი (P&L)]
Resident ДинамДолиПЛ
Where [_დინამ ჯამი (P&L)] > 0;

Drop Table ДинамДолиПЛ;
// ДинамНаправленияПЛ აქ აღარ იშლება — ბიუჯეტის ნორმალიზებული წილებიც მასზე შენდება
// (ДинамДолиНормБюджет); იშლება ბიუჯეტის ბლოკში, სკრიპტის ბოლოს.

// ----- ეტაპი 1: ДоходыИРасходы რეესტრი -----

РегистрНакопленияДоходыИРасходыPre:
LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_РегистрНакопленияДоходыИРасходы-*.qvd]
(qvd);

// ანტი-ჯოინის საყრდენი — შეგნებულად უფილტროდ, pl.txt-ის სემანტიკის მიხედვით (ეტაპი 2 გამორიცხავს
// ყველა რეგისტრატორს, რომელიც რეესტრში საერთოდ გვხვდება, ფანჯრის/ორგანიზაციის მიუხედავად)
РегистраторыДР:
Load Distinct
    [Регистратор] as [%exists_РегистраторДР (P&L)]
Resident РегистрНакопленияДоходыИРасходыPre;

ПЛСтейджинг:
NoConcatenate Load
    floor(Date(AddYears([Период],-2000),'DD/MM/YYYY HH:mm:ss')) as PLDate,
    [Регистратор] as [%lnk_რეგისტრატორი (P&L)],
    [ორგანიზაცია] as [%lnk_ორგანიზაცია (P&L)],
    [სტრუქტურული ერთეული] as [_ერთეული (P&L)],
    [აღრიცხვის ანგარიში] as [_ანგარიში (P&L)],
    [შემოსავლების თანხა] as [_შემოსავალი (P&L)],
    [ხარჯების ოდენობა] as [_ხარჯი (P&L)],
    'რეესტრი' as [წყარო (P&L)]
// აქტიურობის ფილტრი აქ არ გვჭირდება — ექსტრაქციის SQL უკვე იღებს მხოლოდ აქტიურ ჩანაწერებს
// (WHERE tt._Active = 0x01, იხ. გენერირებული სკრიპტი)
Resident РегистрНакопленияДоходыИРасходыPre
Where
    floor(AddYears([Период],-2000)) < $(vPLEnd)
    and floor(AddYears([Период],-2000)) >= $(vPLStart)
    and match([ორგანიზაცია],
    '85070A94EF044E4711EB87F29D540806', // elvare
    '80C6382C4ABBB43711E7363EBFB98EBD', // electric
    '8653D4F5EF3EE94F11EED6FFAF64F778' // elcom
    ) > 0;

Drop Table РегистрНакопленияДоходыИРасходыPre;

// ----- ეტაპი 2: Управленческий ჟურნალი (გაერთიანება + ანტი-ჯოინი Регистратор-ით) -----
// ანგარიშის ბრუნვა აღდგება ორი გავლით: დტ მხარე = +თანხა, კტ მხარე = −თანხა.
// pl.txt-ის "ССЫЛКА Документ.X" პირობებს ფარავს QVD-ის [Регистратор_TYPE] ტექსტური სვეტი.

УправленческийПЛPre:
LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_РегистрБухгалтерииУправленческий-*.qvd]
(qvd);

УправленческийДвиженияПЛ:
NoConcatenate Load
    [Период],
    [Регистратор],
    [ორგანიზაცია],
    [ანგარიში დტ] as [_ანგარიში (P&L)],
    ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში დტ],Null()) as [_ტიპი (P&L)],
    [თანხა] as [_ბრუნვა (P&L)]
Resident УправленческийПЛPre
Where
    floor(AddYears([Период],-2000)) < $(vPLEnd)
    and floor(AddYears([Период],-2000)) >= $(vPLStart)
    and match([ორგანიზაცია],
    '85070A94EF044E4711EB87F29D540806', // elvare
    '80C6382C4ABBB43711E7363EBFB98EBD', // electric
    '8653D4F5EF3EE94F11EED6FFAF64F778' // elcom
    ) > 0
    and not Exists([%exists_РегистраторДР (P&L)],[Регистратор])
    and (
        (   match(ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში დტ],'@'),
                'ხარჯები (ფინანსურ შედეგზე განაწილებული)','სხვა ხარჯები (ფინანსურ შედეგზე განაწილებული)','შემოსავლები','სხვა შემოსავლები')
            and [Регистратор_TYPE] = 'ДокументОперация' )
        or
        (   ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში დტ],'@') = 'ანგარიშების ჯგუფი'
            and match(Left(ApplyMap('MapПланСчетовУправленческийКод',[ანგარიში დტ],''),1),'6','7','8','9')
            and [Регистратор_TYPE] = 'ДокументВводНачальныхОстатков' )
        or
        (   ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში დტ],'@') = 'სესხების პროცენტი'
            and match(Left(ApplyMap('MapПланСчетовУправленческийКод',[ანგარიში დტ],''),1),'6','7','8','9')
            and [Регистратор_TYPE] = 'ДокументПриходнаяНакладная' )
    );

Concatenate(УправленческийДвиженияПЛ)
Load
    [Период],
    [Регистратор],
    [ორგანიზაცია],
    [ანგარიში კტ] as [_ანგარიში (P&L)],
    ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში კტ],Null()) as [_ტიპი (P&L)],
    -1 * [თანხა] as [_ბრუნვა (P&L)]
Resident УправленческийПЛPre
Where
    floor(AddYears([Период],-2000)) < $(vPLEnd)
    and floor(AddYears([Период],-2000)) >= $(vPLStart)
    and match([ორგანიზაცია],
    '85070A94EF044E4711EB87F29D540806', // elvare
    '80C6382C4ABBB43711E7363EBFB98EBD', // electric
    '8653D4F5EF3EE94F11EED6FFAF64F778' // elcom
    ) > 0
    and not Exists([%exists_РегистраторДР (P&L)],[Регистратор])
    and (
        (   match(ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში კტ],'@'),
                'ხარჯები (ფინანსურ შედეგზე განაწილებული)','სხვა ხარჯები (ფინანსურ შედეგზე განაწილებული)','შემოსავლები','სხვა შემოსავლები')
            and [Регистратор_TYPE] = 'ДокументОперация' )
        or
        (   ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში კტ],'@') = 'ანგარიშების ჯგუფი'
            and match(Left(ApplyMap('MapПланСчетовУправленческийКод',[ანგარიში კტ],''),1),'6','7','8','9')
            and [Регистратор_TYPE] = 'ДокументВводНачальныхОстатков' )
        or
        (   ApplyMap('MapПланСчетовУправленческийТипСчета',[ანგარიში კტ],'@') = 'სესხების პროცენტი'
            and match(Left(ApplyMap('MapПланСчетовУправленческийКод',[ანგარიში კტ],''),1),'6','7','8','9')
            and [Регистратор_TYPE] = 'ДокументПриходнаяНакладная' )
    );

Drop Table УправленческийПЛPre;

// შემოსავლის ტიპებზე ბრუნვა კრედიტულია → ნიშანი იცვლება (pl.txt: -1 * СуммаОборот)
Concatenate(ПЛСтейджинг)
Load
    floor(Date(AddYears([Период],-2000),'DD/MM/YYYY HH:mm:ss')) as PLDate,
    [Регистратор] as [%lnk_რეგისტრატორი (P&L)],
    [ორგანიზაცია] as [%lnk_ორგანიზაცია (P&L)],
    Null() as [_ერთეული (P&L)],
    [_ანგარიში (P&L)],
    if(match([_ტიპი (P&L)],'ხარჯები (ფინანსურ შედეგზე განაწილებული)','სხვა ხარჯები (ფინანსურ შედეგზე განაწილებული)'), 0, -1 * sum([_ბრუნვა (P&L)])) as [_შემოსავალი (P&L)],
    if(match([_ტიპი (P&L)],'ხარჯები (ფინანსურ შედეგზე განაწილებული)','სხვა ხარჯები (ფინანსურ შედეგზე განაწილებული)'), sum([_ბრუნვა (P&L)]), 0) as [_ხარჯი (P&L)],
    'ჟურნალი' as [წყარო (P&L)]
Resident УправленческийДвиженияПЛ
Group by
    floor(Date(AddYears([Период],-2000),'DD/MM/YYYY HH:mm:ss')),
    [Регистратор],
    [ორგანიზაცია],
    [_ანგარიში (P&L)],
    [_ტიპი (P&L)];

Drop Table УправленческийДвиженияПЛ;
Drop Table РегистраторыДР;

// ----- ეტაპი 3: განყოფილების გადაფარვა + სახელები + მატჩინგის გასაღები -----

// გაყიდვების ანგარიშებზე (СчетаРегистраторыИзПродажПЛ) მდგარი სტრიქონები აქვე გამოირიცხება —
// მათ ნაცვლად სკრიპტის ბოლოს გაყიდვების ფაქტიდან აწყობილი სტრიქონები ჯდება, იმავე ანგარიშებით.
ПЛСтейджинг2:
NoConcatenate Load
    *,
    // დაუდგენელი მუხლი Null()-ია და არა ცარიელი სტრიქონი: ცარიელი სტრიქონი განზომილებაში
    // ცალკე (ცარიელად გამოსახული) მნიშვნელობაა, Null კი ნამდვილად "არ არის". მატჩინგის
    // გასაღები ამას ᲐᲠ ეყოლება — იქ სტრიქონი უნდა დარჩეს, თორემ გასაღები შეიცვლება.
    ApplyMap('MapСправочникВидыСчетовPLПЛ',[%lnk_მუხლი (P&L)],Null()) as [მუხლი (P&L)],
    Trim(ApplyMap('MapПланСчетовУправленческий',[_ანგარიში (P&L)],'')) as [ანგარიშის დასახელება (P&L)],
    Trim(ApplyMap('MapПланСчетовУправленческийКод',[_ანგარიში (P&L)],'')) as [ანგარიშის კოდი (P&L)],
    // გასაღები და საწყისი ველი ნორმალიზებულ (ლოკაციამდელ) სახელს ატარებს — ზუსტად იმას,
    // რაც Google-ცხრილის [სტრუქტურული ერთეული] სვეტში წერია; საჩვენებელი ველი — ლოკაციისას.
    // წლის ზღვარი ($(vPLDeptFrom)) მხოლოდ საჩვენებელ ველზეა — გასაღები წელიწადზე
    // დამოკიდებული არ უნდა იყოს, თორემ განაწილება შეიცვლება.
    if(PLDate >= $(vPLDeptFrom), [_ერთეული ლოკაცია (P&L)], '') as [სტრუქტურული ერთეული (P&L)],
    // ნორმალიზებული, წლით შემოუსაზღვრელი სახელი — ზუსტად ის, რაც მატჩინგის გასაღებშია და
    // რაც Google-ცხრილში უნდა ეწეროს. სჭირდება "დაუმატჩებელი" ანგარიშის ფურცელს.
    [_ერთეული სახელი (P&L)] as [სტრუქტურული ერთეული (P&L, საწყისი)],
    Trim(ApplyMap('MapСправочникВидыСчетовPLПЛ',[%lnk_მუხლი (P&L)],''))
        & '|' & [_ერთეული სახელი (P&L)] as [_MatchKey (P&L)]
Where
    not Exists([%exists_СчетРегистратор (P&L)], [_ანგარიში (P&L)] & '|' & [%lnk_რეგისტრატორი (P&L)]);
// შუალედური საფეხური: ერთეულის GUID → სახელი → ნორმალიზება ერთ ადგილას, რომ გასაღებმა,
// საწყისმა და საჩვენებელმა ველმა ერთი წყარო გაიზიარონ; ლოკაცია ცალკე ველია და მხოლოდ
// საჩვენებელს ხმარდება.
Load
    *,
    ApplyMap('MapЛокацияПодразделенияПЛ', [_ერთეული სახელი (P&L)]) as [_ერთეული ლოკაცია (P&L)];
Load
    *,
    ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
        Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული საბოლოო (P&L)],'')),
        Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული საბოლოო (P&L)],''))) as [_ერთეული სახელი (P&L)];
Load
    *,
    ApplyMap('MapПланСчетовУправленческийВидСчетаPL',[_ანგარიში (P&L)],Null()) as [%lnk_მუხლი (P&L)],
    ApplyMap('MapПодразделенияЗатратДоходовСчетовПЛ',
        [%lnk_ორგანიზაცია (P&L)] & '|' & [_ანგარიში (P&L)],
        [_ერთეული (P&L)]) as [_ერთეული საბოლოო (P&L)]
Resident ПЛСтейджинг;

Drop Table ПЛСтейджинг;

// ----- საბოლოო ფაქტი: განაწილება ერთ ტალღად, პირდაპირ საბოლოო კალათებში -----
// სამი შტო: (ა) ფიქსირებული ნაწილი — ცხრილის რიცხვები; (ბ) დინამიური ნაწილი — 'დინამიურად'
// მონიშნული კალათები COGS-ის წილებით; (გ) უპოვარი გასაღები — თვის მთელ ბაზაზე (დროშა
// დამატჩებულია='არა'), რომ არცერთი თანხა არ დარჩეს 'მიმართულების გარეშე' მხოლოდ ცხრილში
// სტრიქონის უქონლობის გამო. შერეული გასაღები (ა)-შიც და (ბ)-შიც ჩნდება — წილები
// ურთიერთშემავსებელია და ჯამში 1-ს იძლევა. განაწილებული სტრიქონის განყოფილება კალათიდან
// მოდის: მაღაზია — სახელით; ყველა დანარჩენ კალათაზე ხარჯის ᲒᲐᲛᲬᲔᲕᲘ განყოფილება ჩანს,
// საცალოს იმავე ჯაჭვით (ნორმალიზება + ლოკაცია) — ᲚᲔᲘᲑᲚᲘᲐ და არა განაწილება: ერთი
// წყარო-სტრიქონის ყველა ნაჭერი ერთსა და იმავე განყოფილებას ატარებს, მიმართულებებს შორის
// კი თანხები არ იძვრის.
// საწყისი ველი ([სტრუქტურული ერთეული (P&L, საწყისი)]) ყველგან ხელუხლებელია.

// (ა) ფიქსირებული ნაწილი: join გასაღებზე → თითო წონიან სვეტზე თითო სტრიქონი.
// თვეზე/COGS-ზე არ არის დამოკიდებული — fallback-წილი არ სჭირდება.
ПЛФиксДоли:
NoConcatenate Load
    *
Resident ПЛСтейджинг2
Where ApplyMap('MapКлючФиксПЛ',[_MatchKey (P&L)],0) = 1;

Left Join(ПЛФиксДоли)
Load
    *
Resident ФиксДолиПЛ;

// ФиксДолиПЛ აქ აღარ იშლება — ბიუჯეტის ფიქსირებული შტოც მასზე ჯდება; იშლება ბიუჯეტის ბლოკში.

РегистрНакопленияДоходыИРасходы:
NoConcatenate Load
    PLDate,
    0 as [ნაშთია (P&L)],
    [%lnk_ორგანიზაცია (P&L)],
    ApplyMap('MapСправочникОрганизации',[%lnk_ორგანიზაცია (P&L)],Null()) as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    [_ფიქს მიმართულება (P&L)] as [მიმართულება (P&L)],
    [%lnk_ორგანიზაცია (P&L)] & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & [_ფიქს მიმართულება (P&L)] as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [%lnk_რეგისტრატორი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [ანგარიშის დასახელება (P&L)],
    [ანგარიშის კოდი (P&L)],
    // განყოფილება: მაღაზიის კალათა — მაღაზიის სახელით; სხვა კალათაზე ხარჯის გამწევი
    // განყოფილება (სტეიჯინგის საჩვენებელი ველი) — ლეიბლია, თანხებს არ ანაწილებს.
    if(Len(Trim([_ფიქს ერთეული (P&L)])) > 0, [_ფიქს ერთეული (P&L)],
        [სტრუქტურული ერთეული (P&L)]) as [სტრუქტურული ერთეული (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    ApplyMap('MapБалансДолейПЛ',[_MatchKey (P&L)],'კი') as [წილები დაბალანსებულია (P&L)],
    // რეესტრის/ჟურნალის სტრიქონები არც შიდაა და არც არაძირითადი → ორივე 'არა',
    // რომ აპის სტანდარტული ფილტრი (ორივე = 'არა') მათ არ ამოაგდოს.
    ApplyMap('MapСчетаEEEПЛ', [_ანგარიში (P&L)], 'არა') as [Internal (P&L)],
    ApplyMap('MapСчетаEEEПЛ', [_ანგარიში (P&L)], 'არა') as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    // ვარიანტების ჯგუფი: ზედნადები მიმართულებები ცალკე ჯგუფდება — იხ. გადანაწილების ბლოკი ბოლოში
    pick(match([_ფიქს მიმართულება (P&L)],
        'ლოგისტიკა','ადმინისტრაცია') + 1,
        'COMMON','LOG_AS_IS','ADM_AS_IS') as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_შემოსავალი (P&L)] * [_ფიქს წილი (P&L)] as [შემოსავალი (P&L)],
    [_ხარჯი (P&L)] * [_ფიქს წილი (P&L)] as [ხარჯი (P&L)],
    ([_შემოსავალი (P&L)] - [_ხარჯი (P&L)]) * [_ფიქს წილი (P&L)] as [თანხა (P&L)]
Resident ПЛФиксДоли;

Drop Table ПЛФиксДоли;

// (ბ) დინამიური ნაწილი: 'დინამიურად' მონიშნული კალათები → join გასაღები+თვე, გაშლა მონიშნულ
// კალათებზე ნორმალიზებული წილებით. თანხის ეს ნაწილი = ნაშთი (1 − რიცხვების ჯამი; ურიცხვო
// გასაღებზე 1). თვე, სადაც არცერთ მონიშნულ კალათას წილი არ აქვს, არ იშლება და მთლიანად
// 'მიმართულების გარეშე' რჩება (Alt-ის fallback).
ПЛДинамика:
NoConcatenate Load
    *,
    [_MatchKey (P&L)] as [_დინამ გასაღები (P&L)],
    MonthStart(PLDate) as [_დინამ თვე (P&L)],
    ApplyMap('MapДинамОстатокПЛ',[_MatchKey (P&L)],1) as [_დინამ ნაშთი (P&L)]
Resident ПЛСтейджинг2
Where ApplyMap('MapКлючДинамПЛ',[_MatchKey (P&L)],0) = 1;

Left Join(ПЛДинамика)
Load
    *
Resident ДинамДолиНормПЛ;

Drop Table ДинамДолиНормПЛ;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    [%lnk_ორგანიზაცია (P&L)],
    ApplyMap('MapСправочникОрганизации',[%lnk_ორგანიზაცია (P&L)],Null()) as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    if(Len(Trim([_დინამ მიმართულება (P&L)])) > 0, [_დინამ მიმართულება (P&L)], 'მიმართულების გარეშე') as [მიმართულება (P&L)],
    [%lnk_ორგანიზაცია (P&L)] & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & if(Len(Trim([_დინამ მიმართულება (P&L)])) > 0, [_დინამ მიმართულება (P&L)], 'მიმართულების გარეშე') as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [%lnk_რეგისტრატორი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [ანგარიშის დასახელება (P&L)],
    [ანგარიშის კოდი (P&L)],
    // განყოფილება: მაღაზიის კალათა — სახელით; სხვა კალათა და უწილო თვე — გამწევი
    // განყოფილებით (სტეიჯინგის საჩვენებელი ველი)
    if(Len(Trim([_დინამ მიმართულება (P&L)])) > 0 and Len(Trim([_დინამ ერთეული (P&L)])) > 0,
        [_დინამ ერთეული (P&L)],
        [სტრუქტურული ერთეული (P&L)]) as [სტრუქტურული ერთეული (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    ApplyMap('MapБалансДолейПЛ',[_MatchKey (P&L)],'კი') as [წილები დაბალანსებულია (P&L)],
    ApplyMap('MapСчетаEEEПЛ', [_ანგარიში (P&L)], 'არა') as [Internal (P&L)],
    ApplyMap('MapСчетаEEEПЛ', [_ანგარიში (P&L)], 'არა') as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    // დინამიური კალათები მხოლოდ კომერციულია (ბაზაში ლოგისტიკა/ადმინისტრაცია არ არსებობს),
    // fallback — 'მიმართულების გარეშე' → ყოველთვის საერთო ჯგუფი
    'COMMON' as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_შემოსავალი (P&L)] * [_დინამ ნაშთი (P&L)] * Alt([_დინამ ნორმ წილი (P&L)],1) as [შემოსავალი (P&L)],
    [_ხარჯი (P&L)] * [_დინამ ნაშთი (P&L)] * Alt([_დინამ ნორმ წილი (P&L)],1) as [ხარჯი (P&L)],
    ([_შემოსავალი (P&L)] - [_ხარჯი (P&L)]) * [_დინამ ნაშთი (P&L)] * Alt([_დინამ ნორმ წილი (P&L)],1) as [თანხა (P&L)]
Resident ПЛДинамика;

Drop Table ПЛДинамика;

// (გ) უპოვარი გასაღები: ცხრილში სტრიქონი არ აქვს → თვის ᲛᲗᲔᲚ ბაზაზე (5 კალათა) გაშლა,
// დროშით დამატჩებულია='არა'. უბაზო თვე ერთ სტრიქონად 'მიმართულების გარეშე' რჩება.
ПЛБезМатча:
NoConcatenate Load
    *,
    MonthStart(PLDate) as [_თვე (P&L)]
Resident ПЛСтейджинг2
Where ApplyMap('MapКлючМатчПЛ',[_MatchKey (P&L)],0) = 0;

Left Join(ПЛБезМатча)
Load
    *
Resident ДолиСебестоимости;

Drop Table ДолиСебестоимости;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    [%lnk_ორგანიზაცია (P&L)],
    ApplyMap('MapСправочникОрганизации',[%lnk_ორგანიზაცია (P&L)],Null()) as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    if(Len(Trim([_მიმართულება (P&L წილი)])) > 0, [_მიმართულება (P&L წილი)], 'მიმართულების გარეშე') as [მიმართულება (P&L)],
    // განყოფილება: მაღაზიის კალათა — სახელით; სხვა კალათა და უბაზო თვე — გამწევი
    // განყოფილებით (სტეიჯინგის საჩვენებელი ველი)
    if(Len(Trim([_მიმართულება (P&L წილი)])) > 0 and Len(Trim([_ერთეული (P&L წილი)])) > 0,
        [_ერთეული (P&L წილი)],
        [სტრუქტურული ერთეული (P&L)]) as [სტრუქტურული ერთეული (P&L)],
    [%lnk_ორგანიზაცია (P&L)] & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & if(Len(Trim([_მიმართულება (P&L წილი)])) > 0, [_მიმართულება (P&L წილი)], 'მიმართულების გარეშე') as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [%lnk_რეგისტრატორი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [ანგარიშის დასახელება (P&L)],
    [ანგარიშის კოდი (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [წყარო (P&L)],
    'არა' as [დამატჩებულია (P&L)],
    ApplyMap('MapСчетаEEEПЛ', [_ანგარიში (P&L)], 'არა') as [Internal (P&L)],
    ApplyMap('MapСчетаEEEПЛ', [_ანგარიში (P&L)], 'არა') as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    // ბაზის კალათები მხოლოდ კომერციულია, fallback — 'მიმართულების გარეშე' → ყოველთვის საერთო ჯგუფი
    'COMMON' as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_შემოსავალი (P&L)] * Alt([_წილი (P&L)],1) as [შემოსავალი (P&L)],
    [_ხარჯი (P&L)] * Alt([_წილი (P&L)],1) as [ხარჯი (P&L)],
    ([_შემოსავალი (P&L)] - [_ხარჯი (P&L)]) * Alt([_წილი (P&L)],1) as [თანხა (P&L)]
Resident ПЛБезМатча;

Drop Table ПЛБезМатча;

Drop Table ПЛСтейджинг2;
Drop Table СчетаРегистраторыИзПродажПЛ;

// ----- გაყიდვები P&L-ში პირდაპირ გაყიდვების ფაქტიდან, ანგარიშების ჭრილში -----
// შემოსავალიც და თვითღირებულებაც ჩანაცვლებულია — ორივე მხოლოდ ჩვეულებრივი ანგარიშებით
// (СчетУчетаВыручкиОтПродаж / СчетУчетаСебестоимостиПродаж), შიდა ოპერაციების ვარიანტების გარეშე.
// პროპორციების ფილტრები აქ არ გამოიყენება — მხოლოდ გეგმის სტრიქონები გამოირიცხება.
// ანგარიშდაუდგენელი სტრიქონები არ ინექცირდება (მათი რეესტრის სტრიქონები ისედაც რჩება).



// შემოსავალი: დღე × ორგანიზაცია × მიმართულება × ანგარიში
Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    SalesDate as PLDate,
    0 as [ნაშთია (P&L)],
    [_ორგანიზაცია (P&L გაყიდვები)] as [%lnk_ორგანიზაცია (P&L)],
    ApplyMap('MapСправочникОрганизации',[_ორგანიზაცია (P&L გაყიდვები)],Null()) as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    [_მიმართულება (P&L გაყიდვები)] as [მიმართულება (P&L)],
    [_მიმართულება საწყისი (P&L გაყიდვები)] as [მიმართულება (P&L, საწყისი)],
    [_ორგანიზაცია (P&L გაყიდვები)] & '|' & 'PL' & '|' & SalesDate & '|' & 0 & '|'
        & [_მიმართულება (P&L გაყიდვები)] as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(SalesDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [_რეგისტრატორი (P&L გაყიდვები)] as [%lnk_რეგისტრატორი (P&L)],
    ApplyMap('MapСправочникВидыСчетовPLПЛ', ApplyMap('MapПланСчетовУправленческийВидСчетаPL',[_შემოსავლის ანგარიში (P&L)],''), Null()) as [მუხლი (P&L)],
    ApplyMap('MapПланСчетовУправленческийВидСчетаPL',[_შემოსავლის ანგარიში (P&L)],Null()) as [%lnk_მუხლი (P&L)],
    Trim(ApplyMap('MapПланСчетовУправленческий',[_შემოსავლის ანგარიში (P&L)],'')) as [ანგარიშის დასახელება (P&L)],
    Trim(ApplyMap('MapПланСчетовУправленческийКод',[_შემოსავლის ანგარიში (P&L)],'')) as [ანგარიშის კოდი (P&L)],
    [_Internal (P&L გაყიდვები)] as [Internal (P&L)],
    [_Internal EEE (P&L გაყიდვები)] as [Internal EEE (P&L)],
    [_არაძირითადი (P&L გაყიდვები)] as [არ არის ძირითადი (P&L)],
    // საჩვენებელი განყოფილება: ყველა მიმართულებაზე ერთი ჯაჭვი — ნორმალიზება + ლოკაცია,
    // წლის ზღვრით. საწყისი ველი ნორმალიზებული და ლოკაციამდელია, ზღვრის გარეშე (აუდიტი/ცხრილი).
    if(SalesDate >= $(vPLDeptFrom),
        ApplyMap('MapЛокацияПодразделенияПЛ',
            ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')),
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')))),
        '') as [სტრუქტურული ერთეული (P&L)],
    ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
        Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')),
        Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],''))) as [სტრუქტურული ერთეული (P&L, საწყისი)],
    'გაყიდვები' as [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    pick(match([_მიმართულება (P&L გაყიდვები)],'ლოგისტიკა','ადმინისტრაცია') + 1,
        'COMMON','LOG_AS_IS','ADM_AS_IS') as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    Sum([_თანხა (P&L გაყიდვები)]) as [შემოსავალი (P&L)],
    0 as [ხარჯი (P&L)],
    Sum([_თანხა (P&L გაყიდვები)]) as [თანხა (P&L)]
Resident ПродажиДляПЛ
Where Len([_შემოსავლის ანგარიში (P&L)]) > 0
Group by
    SalesDate,
    [_ორგანიზაცია (P&L გაყიდვები)],
    [_მიმართულება (P&L გაყიდვები)],
    [_მიმართულება საწყისი (P&L გაყიდვები)],
    [_შემოსავლის ანგარიში (P&L)],
    [_რეგისტრატორი (P&L გაყიდვები)],
    [_Internal (P&L გაყიდვები)],
    [_Internal EEE (P&L გაყიდვები)],
    [_არაძირითადი (P&L გაყიდვები)],
    [_ერთეული (P&L გაყიდვები)];

// თვითღირებულება: დღე × ორგანიზაცია × მიმართულება × ანგარიში (ხარჯი, თანხა უარყოფითი; მხოლოდ ჩვეულებრივი ანგარიში)
Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    SalesDate as PLDate,
    0 as [ნაშთია (P&L)],
    [_ორგანიზაცია (P&L გაყიდვები)] as [%lnk_ორგანიზაცია (P&L)],
    ApplyMap('MapСправочникОрганизации',[_ორგანიზაცია (P&L გაყიდვები)],Null()) as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    [_მიმართულება (P&L გაყიდვები)] as [მიმართულება (P&L)],
    [_მიმართულება საწყისი (P&L გაყიდვები)] as [მიმართულება (P&L, საწყისი)],
    [_ორგანიზაცია (P&L გაყიდვები)] & '|' & 'PL' & '|' & SalesDate & '|' & 0 & '|'
        & [_მიმართულება (P&L გაყიდვები)] as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(SalesDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [_რეგისტრატორი (P&L გაყიდვები)] as [%lnk_რეგისტრატორი (P&L)],
    ApplyMap('MapСправочникВидыСчетовPLПЛ', ApplyMap('MapПланСчетовУправленческийВидСчетаPL',[_თვითღირებულების ანგარიში (P&L)],''), Null()) as [მუხლი (P&L)],
    ApplyMap('MapПланСчетовУправленческийВидСчетаPL',[_თვითღირებულების ანგარიში (P&L)],Null()) as [%lnk_მუხლი (P&L)],
    Trim(ApplyMap('MapПланСчетовУправленческий',[_თვითღირებულების ანგარიში (P&L)],'')) as [ანგარიშის დასახელება (P&L)],
    Trim(ApplyMap('MapПланСчетовУправленческийКод',[_თვითღირებულების ანგარიში (P&L)],'')) as [ანგარიშის კოდი (P&L)],
    [_Internal (P&L გაყიდვები)] as [Internal (P&L)],
    [_Internal EEE (P&L გაყიდვები)] as [Internal EEE (P&L)],
    [_არაძირითადი (P&L გაყიდვები)] as [არ არის ძირითადი (P&L)],
    // საჩვენებელი განყოფილება: ყველა მიმართულებაზე ერთი ჯაჭვი — ნორმალიზება + ლოკაცია,
    // წლის ზღვრით. საწყისი ველი ნორმალიზებული და ლოკაციამდელია, ზღვრის გარეშე (აუდიტი/ცხრილი).
    if(SalesDate >= $(vPLDeptFrom),
        ApplyMap('MapЛокацияПодразделенияПЛ',
            ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')),
                Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')))),
        '') as [სტრუქტურული ერთეული (P&L)],
    ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
        Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],'')),
        Trim(ApplyMap('MapСправочникСтруктурныеЕдиницы',[_ერთეული (P&L გაყიდვები)],''))) as [სტრუქტურული ერთეული (P&L, საწყისი)],
    'გაყიდვები' as [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    pick(match([_მიმართულება (P&L გაყიდვები)],'ლოგისტიკა','ადმინისტრაცია') + 1,
        'COMMON','LOG_AS_IS','ADM_AS_IS') as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    0 as [შემოსავალი (P&L)],
    Sum([_თვითღირებულება (P&L გაყიდვები)]) as [ხარჯი (P&L)],
    -1 * Sum([_თვითღირებულება (P&L გაყიდვები)]) as [თანხა (P&L)]
Resident ПродажиДляПЛ
Where Len([_თვითღირებულების ანგარიში (P&L)]) > 0
Group by
    SalesDate,
    [_ორგანიზაცია (P&L გაყიდვები)],
    [_მიმართულება (P&L გაყიდვები)],
    [_მიმართულება საწყისი (P&L გაყიდვები)],
    [_თვითღირებულების ანგარიში (P&L)],
    [_რეგისტრატორი (P&L გაყიდვები)],
    [_Internal (P&L გაყიდვები)],
    [_Internal EEE (P&L გაყიდვები)],
    [_არაძირითადი (P&L გაყიდვები)],
    [_ერთეული (P&L გაყიდვები)];

Drop Table ПродажиДляПЛ;

// ----- გადანაწილების ვარიანტები: ზედნადები მიმართულებების გაშლა კომერციულ კალათებზე -----
// ლოგისტიკისა და ადმინისტრაციის სტრიქონების ასლები თვის თვითღირებულების წილებით ნაწილდება
// ბაზის 5 კალათაზე (დისტრიბუცია, კორპორატიული, საცალოს 3 მაღაზია) და ცალკე ჯგუფებით
// ემატება ფაქტს; ორიგინალები უცვლელი რჩება.
// მუხლი და სხვა ატრიბუტები ასლებზეც იგივეა; იცვლება მხოლოდ მიმართულება, გასაღები,
// თანხები (× წილი), ჯგუფი და მარკერი. უწილო თვის ასლი წყაროს მიმართულებაზე რჩება წილით 1.
// აპში ვარიანტს ცვლადი (vPLVariant) ირჩევს set analysis-ით — მოდიფიკატორის გარეშე
// ჯამში ზედნადები ორჯერ დაითვლება (as-is და გაშლილი ასლები ერთად).
ПЛАллокация:
NoConcatenate Load
    PLDate,
    MonthStart(PLDate) as [_ალოკ თვე (P&L)],
    [მიმართულება (P&L)] as [_ალოკ წყარო (P&L)],
    [%lnk_ორგანიზაცია (P&L)],
    [ორგანიზაცია (P&L)],
    [%lnk_რეგისტრატორი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [ანგარიშის დასახელება (P&L)],
    [ანგარიშის კოდი (P&L)],
    [სტრუქტურული ერთეული (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [მიმართულება (P&L, საწყისი)],
    [წყარო (P&L)],
    [დამატჩებულია (P&L)],
    [წილები დაბალანსებულია (P&L)],
    [Internal (P&L)],
    [Internal EEE (P&L)],
    [არ არის ძირითადი (P&L)],
    [შემოსავალი (P&L)] as [_ალოკ შემოსავალი (P&L)],
    [ხარჯი (P&L)] as [_ალოკ ხარჯი (P&L)],
    [თანხა (P&L)] as [_ალოკ თანხა (P&L)]
Resident РегистрНакопленияДоходыИРасходы
// ბიუჯეტის სტრიქონები აქ არ შემოდის — მათ საკუთარი გაშლის ბლოკი აქვთ გეგმის წილებით
// (ქვემოთ); ამ დაცვის გარეშე გეგმა ჩუმად ფაქტის წილებით გაიშლებოდა.
Where match([_PL ვარიანტის ჯგუფი],'LOG_AS_IS','ADM_AS_IS') > 0
    and not [წყარო (P&L)] = 'ბიუჯეტი';

// თვეზე ≤5 კალათად გაშლა; უწილო თვე ერთ სტრიქონად, ცარიელი წილით რჩება
Left Join(ПЛАллокация)
Load * Resident ДолиДляАллокацииПЛ;

Drop Table ДолиДляАллокацииПЛ;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    [%lnk_ორგანიზაცია (P&L)],
    [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    if(Len(Trim([_ალოკ მიმართულება (P&L)])) > 0, [_ალოკ მიმართულება (P&L)], [_ალოკ წყარო (P&L)]) as [მიმართულება (P&L)],
    // განყოფილება: მაღაზიის კალათა — სახელით; სხვა კალათა და უწილო თვე — წყაროს საჩვენებელი
    // განყოფილებით (as-is სტრიქონზე ის უკვე გამწევის ლოკაცია-ჯაჭვიანი სახელია)
    if(Len(Trim([_ალოკ მიმართულება (P&L)])) > 0 and Len(Trim([_ალოკ ერთეული (P&L)])) > 0,
        [_ალოკ ერთეული (P&L)],
        [სტრუქტურული ერთეული (P&L)]) as [სტრუქტურული ერთეული (P&L)],
    [%lnk_ორგანიზაცია (P&L)] & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & if(Len(Trim([_ალოკ მიმართულება (P&L)])) > 0, [_ალოკ მიმართულება (P&L)], [_ალოკ წყარო (P&L)]) as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [%lnk_რეგისტრატორი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [ანგარიშის დასახელება (P&L)],
    [ანგარიშის კოდი (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [მიმართულება (P&L, საწყისი)],
    [წყარო (P&L)],
    [დამატჩებულია (P&L)],
    [წილები დაბალანსებულია (P&L)],
    [Internal (P&L)],
    [Internal EEE (P&L)],
    [არ არის ძირითადი (P&L)],
    if([_ალოკ წყარო (P&L)] = 'ლოგისტიკა', 'LOG_ALLOC', 'ADM_ALLOC') as [_PL ვარიანტის ჯგუფი],
    if([_ალოკ წყარო (P&L)] = 'ლოგისტიკა', 'ლოგისტიკიდან', 'ადმინისტრაციიდან') as [გადანაწილების წყარო (P&L)],
    [_ალოკ შემოსავალი (P&L)] * Alt([_ალოკ წილი (P&L)],1) as [შემოსავალი (P&L)],
    [_ალოკ ხარჯი (P&L)] * Alt([_ალოკ წილი (P&L)],1) as [ხარჯი (P&L)],
    [_ალოკ თანხა (P&L)] * Alt([_ალოკ წილი (P&L)],1) as [თანხა (P&L)]
Resident ПЛАллокация;

Drop Table ПЛАллокация;

// ----- ბიუჯეტი (გეგმა): იგივე განაწილება, ბაზა — გეგმის თვითღირებულება -----
// წყარო: ბიუჯეტის ცხრილი — სვეტები [მუხლი] | [სტრუქტურული ერთეული] | [მიმართულება] | თვეები (სათაური =
// თვის პირველი დღე, YYYY-MM-DD). თანხები P&L-ის ნიშნით შედის (შემოსავალი +, ხარჯი −) და
// უცვლელად ჯდება ცალკე ველში [ბიუჯეტი (P&L)] — შემოსავალი/ხარჯი/თანხა ცარიელი რჩება, არსებული
// საზომები არ იცვლება. ორგანიზაცია — ფსევდო 'ბიუჯეტი' (ჰოლდინგის დონე: რეალური კომპანიის არჩევა
// გეგმას მალავს), კონტრაგენტი 'PL' (ხიდი ჯგუფს კონტრაგენტით ირჩევს — SD 0301/0101 უცვლელია).
// თარიღის ფანჯარა (vPLStart/vPLEnd) შეგნებულად ᲐᲠ ედება — გეგმა მომავალ თვეებსაც ფარავს.
// ყველა სტრიქონი რეესტრის/ჟურნალის წესით ნაწილდება (მატჩინგის ცხრილი, იგივე მარკერ-რუკები
// და წონები), გარდა გაყიდვების ორი მუხლისა ($(vPLBudgetSalesArticles)): ისინი ინექციის
// ანალოგია — მატჩინგს გვერდს უვლიან, მიმართულება [მიმართულება] სვეტიდან მოდის; ცარიელი
// მიმართულების სტრიქონი გაყიდვების მონაცემი არ არის და მატჩინგში გადის, ბაზაშიც არ შედის.
// თვითღირებულების მუხლი წილების ბაზას მხოლოდ მიმართულებიანი სტრიქონებით იძლევა
// (ფაქტის წილები მომავალზე არ არსებობს).

// მუხლის სახელი → GUID ფოთლის პრიორიტეტით (2026-08-04; ადრე მხოლოდ ფოთლები): რუკა ჯერ ფოთლებს
// ტვირთავს, მერე ჯგუფებს — mapping-ში გასაღების პირველი შემთხვევა რჩება. დუბლიკატი სახელი
// (მაგ. რეალიზებული პროდუქციის თვითირებულება ორჯერ არსებობს) ფოთოლს რჩება — ქცევა უცვლელია;
// მხოლოდ ჯგუფად არსებული სახელი კი ახლა ჯგუფის GUID-ს იღებს და იერარქიაში ისევე ჩანს, როგორც
// ჯგუფის კვანძზე მდგარი ფაქტის გატარება. [მუხლი (P&L)] → Null მხოლოდ ცნობარში უცნობ სახელზე
// რჩება (შესამოწმებელ ფურცელზე ჩანს); სტრიქონი ᲐᲠ იკარგება — თანხა უპოვარი გასაღების შტოთი
// ნაწილდება.
МухлиРодителиПЛ:
Load Distinct
    [Родитель] as [%exists_მუხლი მშობელი (P&L)]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_СправочникВидыСчетовPL.qvd]
(qvd)
Where not [Родитель] = '00000000000000000000000000000000';

МухлиИмяГидПЛ:
NoConcatenate Load
    Trim([Наименование]) as [_ИмяМухлиПЛ],
    [Ссылка] as [_ГидМухлиПЛ],
    if(Exists([%exists_მუხლი მშობელი (P&L)], [Ссылка]), 1, 0) as [_ГруппаМухлиПЛ]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_СправочникВидыСчетовPL.qvd]
(qvd)
// წაშლის ნიშნიანი დუბლიკატი სახელით GUID-ს ვერ დაიკავებს
Where ApplyMap('MapБулево',[ПометкаУдаления],'არა') = 'არა';

MapМухлиИдПЛ:
Mapping Load
    [_ИмяМухлиПЛ],
    [_ГидМухлиПЛ]
Resident МухлиИмяГидПЛ
Order By [_ГруппаМухлиПЛ];

Drop Tables МухлиРодителиПЛ, МухлиИмяГидПЛ;

// 3 ფიქსირებული სვეტი + თვეები; LOAD * — ახალი თვის სვეტი სკრიპტის ცვლილებას არ საჭიროებს.
// ცარიელი/არარიცხვითი უჯრები ქვემოთ გამოირიცხება.
BudgetPLPre:
Crosstable([_თვე Raw (ბიუჯეტი)], [_თანხა Raw (ბიუჯეტი)], 3)
LOAD *;
SELECT *
FROM GetWorksheetV2
WITH PROPERTIES (
worksheetKey='1VRebtvzdH-Ij2UpG2GdwX0lBCf708UCYBTg_1ojhCy0:_139208043', //PL Budget
gidOverride='',
generatedNumberedColumns='false',
skipRows=''
);

БюджетСтейджинг:
NoConcatenate Load
    *,
    // dual-სახელი რანგით — ისევე, როგორც ფაქტის ყველა სტრიქონზე; Null = ფოთოლი ვერ მოიძებნა
    ApplyMap('MapСправочникВидыСчетовPLПЛ',[%lnk_მუხლი (P&L)],Null()) as [მუხლი (P&L)],
    [_მუხლი (ბიუჯეტი)] & '|' & [_ერთეული (ბიუჯეტი)] as [_MatchKey (P&L)];
Load
    // Floor: Date#-ის dual-ს ტექსტი '2026-07-01' დარჩებოდა PLDate-ის სიმბოლოდ ყველა თარიღზე,
    // რომელიც ფაქტში სხვაგან არ არსებობს (ივლისი+, vPLEnd-ის მიღმა) — და ეს ტექსტი ჯდებოდა
    // გასაღებსა და DateForConnect-ში ('2026-07-01|0' ≠ კალენდრის '46204|0'). ნაწილობრივი
    // გადატვირთვა სწორედ ამ სტრიქონებს კარგავდა (2026-08-05). წმინდა რიცხვი = რეესტრის
    // სტრიქონების იდენტური ფორმა, რომელიც ნაწილობრივს ყოველთვის უძლებდა.
    Floor(Date#(Trim([_თვე Raw (ბიუჯეტი)]),'YYYY-MM-DD')) as PLDate,
    MonthStart(Date#(Trim([_თვე Raw (ბიუჯეტი)]),'YYYY-MM-DD')) as [_თვე (ბიუჯეტი)],
    Trim([მუხლი]) as [_მუხლი (ბიუჯეტი)],
    ApplyMap('MapМухлиИдПЛ',Trim([მუხლი]),Null()) as [%lnk_მუხლი (P&L)],
    // ერთეული ნორმალიზდება იმავე რუკით, რითიც მატჩინგის გასაღები — ცხრილში ისედაც
    // ნორმალიზებული სახელები წერია, უცნობ სახელს რუკა უცვლელად ატარებს. ლოკაცია ცალკე ველად:
    // გასაღები და საწყისი ველი ნორმალიზებულზეა, საჩვენებელი და საცალოს კალათა — ლოკაციაზე
    // (ფაქტის ზუსტი ანალოგი).
    ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
        Trim([სტრუქტურული ერთეული]),
        Trim([სტრუქტურული ერთეული])) as [_ერთეული (ბიუჯეტი)],
    ApplyMap('MapЛокацияПодразделенияПЛ',
        ApplyMap('MapСоответствиеНаименованийПодразделенийПЛ',
            Trim([სტრუქტურული ერთეული]),
            Trim([სტრუქტურული ერთეული]))) as [_ერთეული ლოკაცია (ბიუჯეტი)],
    Trim([მიმართულება]) as [_მიმართულება საწყისი (ბიუჯეტი)],
    Num([_თანხა Raw (ბიუჯეტი)]) as [_თანხა (ბიუჯეტი)]
Where IsNum([_თანხა Raw (ბიუჯეტი)]) and Num([_თანხა Raw (ბიუჯეტი)]) <> 0;
// '-' უჯრა ცარიელის ტოლფასია: ტექსტურ სვეტებში ცარიელი სტრიქონი ხდება; თანხის '-' ზემოთა
// IsNum-ფილტრს ვერ გადის და ისედაც გამოირიცხება, ზუსტად როგორც 0.
Load
    [_თვე Raw (ბიუჯეტი)],
    [_თანხა Raw (ბიუჯეტი)],
    if(Trim([მუხლი]) = '-', '', [მუხლი]) as [მუხლი],
    if(Trim([სტრუქტურული ერთეული]) = '-', '', [სტრუქტურული ერთეული]) as [სტრუქტურული ერთეული],
    if(Trim([მიმართულება]) = '-', '', [მიმართულება]) as [მიმართულება]
Resident BudgetPLPre;

Drop Table BudgetPLPre;

// გაყიდვების ორი მუხლი — ინექციის ანალოგი, ოღონდ მხოლოდ მიმართულებიანი სტრიქონები (2026-08-03):
// ცარიელი (ან 'მიმართულების გარეშე') მიმართულების სტრიქონი გაყიდვების მონაცემი ᲐᲠ არის —
// ის ჩვეულებრივ მუხლად, მატჩინგის ცხრილით ნაწილდება და წილების ბაზაშიც არ შედის.
// ფაქტის ანალოგი: ასეთი გატარება რეესტრიდან/ჟურნალიდან მოდის და მატჩინგში გადის.
БюджетПродажи:
NoConcatenate Load
    *,
    [_მიმართულება საწყისი (ბიუჯეტი)] as [_მიმართულება საბოლოო (ბიუჯეტი)]
Resident БюджетСтейджинг
Where match([_მუხლი (ბიუჯეტი)], $(vPLBudgetSalesArticles)) > 0
    and Len(Trim([_მიმართულება საწყისი (ბიუჯეტი)])) > 0
    and not [_მიმართულება საწყისი (ბიუჯეტი)] = 'მიმართულების გარეშე';

// დანარჩენი — რეესტრის/ჟურნალის წესით, მატჩინგის ცხრილში (გაყიდვების მუხლების უმიმართულებო
// სტრიქონების ჩათვლით)
БюджетСтейджинг2:
NoConcatenate Load
    *
Resident БюджетСтейджинг
Where not (match([_მუხლი (ბიუჯეტი)], $(vPLBudgetSalesArticles)) > 0
    and Len(Trim([_მიმართულება საწყისი (ბიუჯეტი)])) > 0
    and not [_მიმართულება საწყისი (ბიუჯეტი)] = 'მიმართულების გარეშე');

Drop Table БюджетСтейджинг;

// ----- ბაზა: გეგმის თვითღირებულება, თვე × კალათა -----
// კომერციული კალათები — დისტრიბუცია, კორპორატიული (მიმართულების დონეზე, ცარიელი ერთეულით) და
// საცალო ლოკაციების ჭრილში (ყველა ლოკაცია, ცარიელი გამოირიცხება); ლოგისტიკა/ადმინისტრაცია
// ბაზაში არ არსებობს — ფაქტის წესის ზუსტი ანალოგი. Fabs(): თანხები P&L-ის
// ნიშნით შედის (ხარჯი −), წილებს ნიშანი არ სჭირდება.
ДолиСебестоимостиБюджетPre:
Load
    [_თვე (P&L)],
    [_მიმართულება (P&L წილი)],
    [_ერთეული (P&L წილი)],
    sum([_COGS ნედლი (P&L)]) as [_COGS (P&L)]
Group by
    [_თვე (P&L)],
    [_მიმართულება (P&L წილი)],
    [_ერთეული (P&L წილი)];
Load
    [_თვე (ბიუჯეტი)] as [_თვე (P&L)],
    [_მიმართულება საბოლოო (ბიუჯეტი)] as [_მიმართულება (P&L წილი)],
    // კალათა ლოკაციის დონეზეა — ფაქტის წილების ზუსტი ანალოგი
    if([_მიმართულება საბოლოო (ბიუჯეტი)] = 'საცალო', [_ერთეული ლოკაცია (ბიუჯეტი)], '') as [_ერთეული (P&L წილი)],
    Fabs([_თანხა (ბიუჯეტი)]) as [_COGS ნედლი (P&L)]
Resident БюджетПродажи
Where [_მუხლი (ბიუჯეტი)] = '$(vPLBudgetCogsArticle)'
    and (match([_მიმართულება საბოლოო (ბიუჯეტი)],'დისტრიბუცია','კორპორატიული') > 0
        or ([_მიმართულება საბოლოო (ბიუჯეტი)] = 'საცალო'
            and Len(Trim([_ერთეული ლოკაცია (ბიუჯეტი)])) > 0));

Left Join(ДолиСебестоимостиБюджетPre)
Load
    [_თვე (P&L)],
    sum([_COGS (P&L)]) as [_COGS სულ (P&L)]
Resident ДолиСебестоимостиБюджетPre
Group by [_თვე (P&L)];

ДолиСебестоимостиБюджет:
NoConcatenate Load
    [_თვე (P&L)],
    [_მიმართულება (P&L წილი)],
    [_ერთეული (P&L წილი)],
    if([_COGS სულ (P&L)] > 0, [_COGS (P&L)] / [_COGS სულ (P&L)], 0) as [_წილი (P&L)]
Resident ДолиСебестоимостиБюджетPre;

Drop Table ДолиСебестоимостиБюджетPre;

// გადანაწილების ვარიანტებისთვის — ცალკე ასლი გადარქმეული ველებით (ორიგინალი ქვემოთ უპოვარი
// გასაღების შტოში იხარჯება), ФиксДолиПЛ/ДолиДляАллокацииПЛ-ის ანალოგიით.
ДолиДляАллокацииБюджет:
NoConcatenate Load
    [_თვე (P&L)] as [_ალოკ თვე (P&L)],
    [_მიმართულება (P&L წილი)] as [_ალოკ მიმართულება (P&L)],
    [_ერთეული (P&L წილი)] as [_ალოკ ერთეული (P&L)],
    [_წილი (P&L)] as [_ალოკ წილი (P&L)]
Resident ДолиСебестоимостиБюджет
Where [_წილი (P&L)] > 0;

// 'დინამიურად' მონიშნული კალათების ნორმალიზებული წილები გეგმის თვეებზე — იგივე აგება, რაც
// ДинамДолиНормПЛ, ოღონდ გეგმის ბაზაზე. ДинамНаправленияПЛ აქ იხარჯება საბოლოოდ.
ДинамДолиБюджет:
NoConcatenate Load
    [_დინამ გასაღები (P&L)],
    [_დინამ მიმართულება (P&L)],
    [_დინამ ერთეული (P&L)]
Resident ДинамНаправленияПЛ;

Left Join(ДинамДолиБюджет)
Load
    [_მიმართულება (P&L წილი)] as [_დინამ მიმართულება (P&L)],
    [_ერთეული (P&L წილი)] as [_დინამ ერთეული (P&L)],
    [_თვე (P&L)] as [_დინამ თვე (P&L)],
    [_წილი (P&L)] as [_დინამ წილი (P&L)]
Resident ДолиСебестоимостиБюджет
Where [_წილი (P&L)] > 0;

Left Join(ДинамДолиБюджет)
Load
    [_დინამ გასაღები (P&L)],
    [_დინამ თვე (P&L)],
    Sum([_დინამ წილი (P&L)]) as [_დინამ ჯამი (P&L)]
Resident ДинамДолиБюджет
Group By [_დინამ გასაღები (P&L)], [_დინამ თვე (P&L)];

ДинамДолиНормБюджет:
NoConcatenate Load
    [_დინამ გასაღები (P&L)],
    [_დინამ თვე (P&L)],
    [_დინამ მიმართულება (P&L)],
    [_დინამ ერთეული (P&L)],
    [_დინამ წილი (P&L)] / [_დინამ ჯამი (P&L)] as [_დინამ ნორმ წილი (P&L)]
Resident ДинамДолиБюджет
Where [_დინამ ჯამი (P&L)] > 0;

Drop Table ДинамДолиБюджет;
Drop Table ДинамНаправленияПЛ;

// ----- გაყიდვების მუხლების ჩასმა ფაქტში (ინექციის ანალოგი, მატჩინგის გარეშე) -----
Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    'ბიუჯეტი' as [%lnk_ორგანიზაცია (P&L)],
    'ბიუჯეტი' as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    [_მიმართულება საბოლოო (ბიუჯეტი)] as [მიმართულება (P&L)],
    'ბიუჯეტი' & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & [_მიმართულება საბოლოო (ბიუჯეტი)] as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    // საჩვენებელი განყოფილება: ყველა მიმართულებაზე ლოკაცია-ჯაჭვიანი სახელი; წლის ზღვარი
    // აქ ზედმეტია (გეგმის თარიღები ისედაც 2026+-ია). საწყისი — ნორმალიზებული, ლოკაციამდელი.
    [_ერთეული ლოკაცია (ბიუჯეტი)] as [სტრუქტურული ერთეული (P&L)],
    [_ერთეული (ბიუჯეტი)] as [სტრუქტურული ერთეული (P&L, საწყისი)],
    [_მიმართულება საწყისი (ბიუჯეტი)] as [მიმართულება (P&L, საწყისი)],
    'ბიუჯეტი' as [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    ApplyMap('MapБалансДолейПЛ',[_MatchKey (P&L)],'კი') as [წილები დაბალანსებულია (P&L)],
    'არა' as [Internal (P&L)],
    'არა' as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    pick(match([_მიმართულება საბოლოო (ბიუჯეტი)],'ლოგისტიკა','ადმინისტრაცია') + 1,
        'COMMON','LOG_AS_IS','ADM_AS_IS') as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_თანხა (ბიუჯეტი)] as [ბიუჯეტი (P&L)]
Resident БюджетПродажи;

Drop Table БюджетПродажи;

// ----- (ა) ბიუჯეტის ფიქსირებული ნაწილი — იგივე წონები, რაც ფაქტზე -----
БюджетФиксДоли:
NoConcatenate Load
    *
Resident БюджетСтейджинг2
Where ApplyMap('MapКлючФиксПЛ',[_MatchKey (P&L)],0) = 1;

Left Join(БюджетФиксДоли)
Load
    *
Resident ФиксДолиПЛ;

Drop Table ФиксДолиПЛ;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    'ბიუჯეტი' as [%lnk_ორგანიზაცია (P&L)],
    'ბიუჯეტი' as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    [_ფიქს მიმართულება (P&L)] as [მიმართულება (P&L)],
    'ბიუჯეტი' & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & [_ფიქს მიმართულება (P&L)] as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    // მაღაზიის კალათა — სახელით; სხვა კალათაზე გამწევი განყოფილება ლოკაცია-ჯაჭვით
    if(Len(Trim([_ფიქს ერთეული (P&L)])) > 0, [_ფიქს ერთეული (P&L)],
        [_ერთეული ლოკაცია (ბიუჯეტი)]) as [სტრუქტურული ერთეული (P&L)],
    [_ერთეული (ბიუჯეტი)] as [სტრუქტურული ერთეული (P&L, საწყისი)],
    'ბიუჯეტი' as [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    ApplyMap('MapБалансДолейПЛ',[_MatchKey (P&L)],'კი') as [წილები დაბალანსებულია (P&L)],
    'არა' as [Internal (P&L)],
    'არა' as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    pick(match([_ფიქს მიმართულება (P&L)],
        'ლოგისტიკა','ადმინისტრაცია') + 1,
        'COMMON','LOG_AS_IS','ADM_AS_IS') as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_თანხა (ბიუჯეტი)] * [_ფიქს წილი (P&L)] as [ბიუჯეტი (P&L)]
Resident БюджетФиксДоли;

Drop Table БюджетФиксДоли;

// ----- (ბ) ბიუჯეტის დინამიური ნაწილი — გეგმის ნორმალიზებული წილებით -----
БюджетДинамика:
NoConcatenate Load
    *,
    [_MatchKey (P&L)] as [_დინამ გასაღები (P&L)],
    [_თვე (ბიუჯეტი)] as [_დინამ თვე (P&L)],
    ApplyMap('MapДинамОстатокПЛ',[_MatchKey (P&L)],1) as [_დინამ ნაშთი (P&L)]
Resident БюджетСтейджинг2
Where ApplyMap('MapКлючДинамПЛ',[_MatchKey (P&L)],0) = 1;

Left Join(БюджетДинамика)
Load
    *
Resident ДинамДолиНормБюджет;

Drop Table ДинамДолиНормБюджет;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    'ბიუჯეტი' as [%lnk_ორგანიზაცია (P&L)],
    'ბიუჯეტი' as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    if(Len(Trim([_დინამ მიმართულება (P&L)])) > 0, [_დინამ მიმართულება (P&L)], 'მიმართულების გარეშე') as [მიმართულება (P&L)],
    'ბიუჯეტი' & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & if(Len(Trim([_დინამ მიმართულება (P&L)])) > 0, [_დინამ მიმართულება (P&L)], 'მიმართულების გარეშე') as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    // მაღაზიის კალათა — სახელით; სხვა კალათა და უწილო თვე — გამწევი განყოფილებით ლოკაცია-ჯაჭვით
    if(Len(Trim([_დინამ მიმართულება (P&L)])) > 0 and Len(Trim([_დინამ ერთეული (P&L)])) > 0,
        [_დინამ ერთეული (P&L)],
        [_ერთეული ლოკაცია (ბიუჯეტი)]) as [სტრუქტურული ერთეული (P&L)],
    [_ერთეული (ბიუჯეტი)] as [სტრუქტურული ერთეული (P&L, საწყისი)],
    'ბიუჯეტი' as [წყარო (P&L)],
    'კი' as [დამატჩებულია (P&L)],
    ApplyMap('MapБалансДолейПЛ',[_MatchKey (P&L)],'კი') as [წილები დაბალანსებულია (P&L)],
    'არა' as [Internal (P&L)],
    'არა' as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    'COMMON' as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_თანხა (ბიუჯეტი)] * [_დინამ ნაშთი (P&L)] * Alt([_დინამ ნორმ წილი (P&L)],1) as [ბიუჯეტი (P&L)]
Resident БюджетДинамика;

Drop Table БюджетДинамика;

// ----- (გ) ბიუჯეტის უპოვარი გასაღები — თვის მთელ ბაზაზე, დროშით -----
БюджетБезМатча:
NoConcatenate Load
    *,
    [_თვე (ბიუჯეტი)] as [_თვე (P&L)]
Resident БюджетСтейджинг2
Where ApplyMap('MapКлючМатчПЛ',[_MatchKey (P&L)],0) = 0;

Left Join(БюджетБезМатча)
Load
    *
Resident ДолиСебестоимостиБюджет;

Drop Table ДолиСебестоимостиБюджет;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    'ბიუჯეტი' as [%lnk_ორგანიზაცია (P&L)],
    'ბიუჯეტი' as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    if(Len(Trim([_მიმართულება (P&L წილი)])) > 0, [_მიმართულება (P&L წილი)], 'მიმართულების გარეშე') as [მიმართულება (P&L)],
    'ბიუჯეტი' & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & if(Len(Trim([_მიმართულება (P&L წილი)])) > 0, [_მიმართულება (P&L წილი)], 'მიმართულების გარეშე') as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    // მაღაზიის კალათა — სახელით; სხვა კალათა და უბაზო თვე — გამწევი განყოფილებით ლოკაცია-ჯაჭვით
    if(Len(Trim([_მიმართულება (P&L წილი)])) > 0 and Len(Trim([_ერთეული (P&L წილი)])) > 0,
        [_ერთეული (P&L წილი)],
        [_ერთეული ლოკაცია (ბიუჯეტი)]) as [სტრუქტურული ერთეული (P&L)],
    [_ერთეული (ბიუჯეტი)] as [სტრუქტურული ერთეული (P&L, საწყისი)],
    'ბიუჯეტი' as [წყარო (P&L)],
    'არა' as [დამატჩებულია (P&L)],
    'არა' as [Internal (P&L)],
    'არა' as [Internal EEE (P&L)],
    'არა' as [არ არის ძირითადი (P&L)],
    'COMMON' as [_PL ვარიანტის ჯგუფი],
    'საკუთარი' as [გადანაწილების წყარო (P&L)],
    [_თანხა (ბიუჯეტი)] * Alt([_წილი (P&L)],1) as [ბიუჯეტი (P&L)]
Resident БюджетБезМатча;

Drop Table БюджетБезМатча;

Drop Table БюджетСтейджинг2;

// ----- ბიუჯეტის გადანაწილების ვარიანტები — გეგმის წილებით -----
// ფაქტის გაშლის ზუსტი ანალოგი; წყარო მხოლოდ ბიუჯეტის სტრიქონებია (ფაქტის ბლოკი მათ
// გამორიცხავს), წილები — ДолиДляАллокацииБюджет. უწილო თვის ასლი წყაროს მიმართულებაზე
// რჩება წილით 1 — ჯამები ყველა ვარიანტში დაცულია.
БюджетАллокация:
NoConcatenate Load
    PLDate,
    MonthStart(PLDate) as [_ალოკ თვე (P&L)],
    [მიმართულება (P&L)] as [_ალოკ წყარო (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [სტრუქტურული ერთეული (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [მიმართულება (P&L, საწყისი)],
    [წყარო (P&L)],
    [დამატჩებულია (P&L)],
    [წილები დაბალანსებულია (P&L)],
    [Internal (P&L)],
    [Internal EEE (P&L)],
    [არ არის ძირითადი (P&L)],
    [ბიუჯეტი (P&L)] as [_ალოკ ბიუჯეტი (P&L)]
Resident РегистрНакопленияДоходыИРасходы
Where match([_PL ვარიანტის ჯგუფი],'LOG_AS_IS','ADM_AS_IS') > 0
    and [წყარო (P&L)] = 'ბიუჯეტი';

Left Join(БюджетАллокация)
Load * Resident ДолиДляАллокацииБюджет;

Drop Table ДолиДляАллокацииБюджет;

Concatenate(РегистрНакопленияДоходыИРасходы)
Load
    PLDate,
    0 as [ნაშთია (P&L)],
    'ბიუჯეტი' as [%lnk_ორგანიზაცია (P&L)],
    'ბიუჯეტი' as [ორგანიზაცია (P&L)],
    'PL' as [%lnk_კონტრაგენტი (P&L)],
    if(Len(Trim([_ალოკ მიმართულება (P&L)])) > 0, [_ალოკ მიმართულება (P&L)], [_ალოკ წყარო (P&L)]) as [მიმართულება (P&L)],
    // მაღაზიის კალათა — სახელით; სხვა კალათა და უწილო თვე — წყაროს საჩვენებელი განყოფილებით
    // (as-is სტრიქონზე ის უკვე გამწევის ლოკაცია-ჯაჭვიანი სახელია)
    if(Len(Trim([_ალოკ მიმართულება (P&L)])) > 0 and Len(Trim([_ალოკ ერთეული (P&L)])) > 0,
        [_ალოკ ერთეული (P&L)],
        [სტრუქტურული ერთეული (P&L)]) as [სტრუქტურული ერთეული (P&L)],
    'ბიუჯეტი' & '|' & 'PL' & '|' & PLDate & '|' & 0 & '|'
        & if(Len(Trim([_ალოკ მიმართულება (P&L)])) > 0, [_ალოკ მიმართულება (P&L)], [_ალოკ წყარო (P&L)]) as [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია],
    Date(PLDate,'DD/MM/YYYY HH:mm:ss') as [პერიოდი (P&L)],
    [მუხლი (P&L)],
    [%lnk_მუხლი (P&L)],
    [სტრუქტურული ერთეული (P&L, საწყისი)],
    [მიმართულება (P&L, საწყისი)],
    [წყარო (P&L)],
    [დამატჩებულია (P&L)],
    [წილები დაბალანსებულია (P&L)],
    [Internal (P&L)],
    [Internal EEE (P&L)],
    [არ არის ძირითადი (P&L)],
    if([_ალოკ წყარო (P&L)] = 'ლოგისტიკა', 'LOG_ALLOC', 'ADM_ALLOC') as [_PL ვარიანტის ჯგუფი],
    if([_ალოკ წყარო (P&L)] = 'ლოგისტიკა', 'ლოგისტიკიდან', 'ადმინისტრაციიდან') as [გადანაწილების წყარო (P&L)],
    [_ალოკ ბიუჯეტი (P&L)] * Alt([_ალოკ წილი (P&L)],1) as [ბიუჯეტი (P&L)]
Resident БюджетАллокация;

Drop Table БюджетАллокация;


// ----- ვარიანტი → ჯგუფების ბმული -----
// ფაქტს მხოლოდ ჯგუფის ველით ებმის — ერთადერთი შეერთების წერტილი, წრიული ბმის გარეშე.
// dual: ტექსტი ემთხვევა აპის ცვლადს (vPLVariant ინახავს ლეიბლს; set analysis-ში
// ბრჭყალებით: {'$(vPLVariant)'} — უბრჭყალო რიცხვი dual-ის ტექსტს ვერ პოულობს),
// რიცხვი 1..4 — სორტირებისთვის.
ВариантыРаспределенияПЛ:
Load
    dual(pick(VariantNum,
        'ცალ-ცალკე',
        'ლოგისტიკა გადანაწილებული',
        'ადმინისტრაცია გადანაწილებული',
        'ლოგისტიკა და ადმინისტრაცია გადანაწილებული'), VariantNum) as [გადანაწილების ვარიანტი],
    GroupCode as [_PL ვარიანტის ჯგუფი]
Inline [
VariantNum, GroupCode
1, COMMON
1, LOG_AS_IS
1, ADM_AS_IS
2, COMMON
2, LOG_ALLOC
2, ADM_AS_IS
3, COMMON
3, LOG_AS_IS
3, ADM_ALLOC
4, COMMON
4, LOG_ALLOC
4, ADM_ALLOC
];

End If
