if(not IsPartialReload()) then

MapПланСчетовУправленческийPre:
Replace LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_ПланСчетовУправленческий.qvd]
(qvd);

MapПланСчетовУправленческий:
Mapping Replace LOAD
    [მინიშნება],
    [დასახელება]
Resident MapПланСчетовУправленческийPre;

MapПланСчетовУправленческийТипСчета:
Mapping Replace LOAD
    [მინიშნება],
    ApplyMap('MapПеречислениеТипыСчетов',[ანგარიშის ტიპი],Null()) AS [ანგარიშის ტიპი]
Resident MapПланСчетовУправленческийPre;

MapПланСчетовУправленческийКод:
Mapping Replace LOAD
    [მინიშნება],
    [ანგარიშის კოდი]
Resident MapПланСчетовУправленческийPre;

// ანგარიში → მისი P&L მუხლი (ВидСчетаPL); სვეტი QVD-ში ჩნდება _ElvareAnalytics.txt-ის
// განახლებული ექსტრაქციის შემდეგ. გამოიყენება P&L მიმართულებებისთვის (SD 0206).
MapПланСчетовУправленческийВидСчетаPL:
Mapping Replace LOAD
    [მინიშნება],
    [P&&L ანგარიშის სახეობა]
Resident MapПланСчетовУправленческийPre;

Drop Table MapПланСчетовУправленческийPre;

// ----- განყოფილებების სახელების შესაბამისობა (Statement-ის იგივე რეგისტრი) -----
// Statement აპი განყოფილებების სახელებს 1C-ის რეგისტრით ანორმალებს (Statement 0002).
// P&L იმავე რუკას იყენებს, რომ ორივე აპში ერთი და იგივე განყოფილება ერთნაირად დაერქვას
// და Google-ცხრილის მატჩინგის გასაღები დაემთხვეს.
// ტიპის ფილტრი აუცილებელია: მის გარეშე რეგისტრის ყველა ტიპი ჩაედინება რუკაში.
MapПеречислениеТипыСоответствияПЛ:
Mapping LOAD
    [Ссылка],
    Value
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_ПеречислениеТипыСоответствия.qvd]
(qvd);

РегистрСведенийСоответствияЗначенийПЛ:
LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_РегистрСведенийСоответствияЗначений.qvd]
(qvd)
Where
    ApplyMap('MapПеречислениеТипыСоответствияПЛ',[ტიპი],Null()) = 'EEE განყოფილების ჩანაცვლება';

MapСоответствиеНаименованийПодразделенийПЛ:
Mapping LOAD
    ApplyMap('MapСправочникСтруктурныеЕдиницы', [შესაბამისობა], Null()),
    ApplyMap('MapСправочникСтруктурныеЕдиницы', [მნიშვნელობა], Null())
Resident РегистрСведенийСоответствияЗначенийПЛ;

Drop Table РегистрСведенийСоответствияЗначенийПЛ;

// ----- გაყიდვების განყოფილება: დოკუმენტი → შეკვეთა → გაყიდვის სტრუქტურული ერთეული -----
// სვეტების სახელები დადასტურებულია მომხმარებელთან (2026-07-29):
//   [განყოფილება]   ← Подразделение              (РасходнаяНакладная)
//   [შეკვეთა]       ← Заказ                      (РасходнаяНакладная — და არა ЗаказПокупателя;
//                     ეს უკანასკნელი თავად დოკუმენტის სახელია, და არა რეკვიზიტის)
//   [განყოფილება]   ← СтруктурнаяЕдиницаПродажи  (ЗаказПокупателя — იგივე სვეტის სახელი)
// არასწორი სახელი ApplyMap-ს ცარიელს დააბრუნებინებს ᲨᲔᲪᲓᲝᲛᲘᲡ ᲒᲐᲠᲔᲨᲔ — შემოწმდეს
// შევსებული განყოფილებით და არა შეცდომის შეტყობინებით.
ДокументРасходнаяНакладнаяПЛPre:
LOAD
    *
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_ДокументРасходнаяНакладная-*.qvd]
(qvd);

MapДокументПодразделениеПЛ:
Mapping LOAD
    [მინიშნება],
    [განყოფილება]
Resident ДокументРасходнаяНакладнаяПЛPre;

MapДокументЗаказПЛ:
Mapping LOAD
    [მინიშნება],
    [შეკვეთა]
Resident ДокументРасходнаяНакладнаяПЛPre;

Drop Table ДокументРасходнаяНакладнаяПЛPre;

// ორივე ცნობარში სვეტს [განყოფილება] ჰქვია, თუმცა სხვადასხვა რეკვიზიტია:
// ზედდებულზე — Подразделение, შეკვეთაზე — СтруктурнаяЕдиницаПродажи. ცალკე QVD-ებია,
// ამიტომ კოლიზია არ არის, მაგრამ ერთმანეთში აღრევა ადვილია.
MapЗаказЕдиницаПродажиПЛ:
Mapping LOAD
    [მინიშნება],
    [განყოფილება]
FROM [lib://$(vSpace24):DataFiles/$(vSpacePrefix24)_$(vPrefix24)_ДокументЗаказПокупателя.qvd]
(qvd);

End If