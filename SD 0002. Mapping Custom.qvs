LIB CONNECT TO 'Holding:Google_Drive_&_Spreadsheets - george.sabanadze@doctra.ge';

MapБулево:
Mapping Replace 
Load * Inline 
[
lnk, YesNo
00, არა
01, კი
false, არა
true, კი
]; 

СправочникКонтрагентыPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникКонтрагенты.qvd]
(qvd);

MapСправочникКонтрагенты:
Mapping Replace LOAD
    [მინიშნება],
    [(არ გამოიყენება)]
Resident СправочникКонтрагентыPre;

MapСправочникКонтрагентыГруппа:
Mapping Replace LOAD
    [მინიშნება],
    [ჯგუფი]
Resident СправочникКонтрагентыPre;

MapСправочникКонтрагентыОтветственныйМенеджер:
Mapping Replace LOAD
    [მინიშნება],
    [პასუხისმგებელი მენეჯერი]
Resident СправочникКонтрагентыPre;

MapСправочникКонтрагентыОтветственныйПользователь:
Mapping Replace LOAD
    [მინიშნება],
    [პასუხისმგებელი მომხმარებელი]
Resident СправочникКонтрагентыPre;

// ჯგუფის საკუთარი კომპანიები კონტრაგენტებად (GUID → 'კი'): 1C-ის ნიშანი
// [ელექტრომარკეტის შიდა კონტრაგენტი]. SD 0206-ში 'Internal EEE' დროშას იძლევა — ის
// ჩვეულებრივ შიდა-კონტრაგენტის დამატებით რეკვიზიტზე ვიწროა.
MapСправочникКонтрагентыВнутреннийЭМ:
Mapping Replace LOAD
    [მინიშნება],
    'კი'
Resident СправочникКонтрагентыPre
Where ApplyMap('MapБулево',[ელექტრომარკეტის შიდა კონტრაგენტი],'არა') = 'კი';

MapСправочникКонтрагентыКонтрагентРодитель:
Mapping Replace LOAD
    [მინიშნება],
    [კონტრაგენტი მშობელი]
Resident СправочникКонтрагентыPre
Where
    not [კონტრაგენტი მშობელი] = '00000000000000000000000000000000'
    and match ([ეს არის ჯგუფი],'01');

Drop Table СправочникКонтрагентыPre;

MapПланВидовХарактеристикДополнительныеРеквизитыИСведения:
Mapping Replace LOAD
    [Ссылка],
    [Наименование];
LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_ПланВидовХарактеристикДополнительныеРеквизитыИСведения.qvd]
(qvd);

СправочникКонтрагентыДополнительныеРеквизитыPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникКонтрагентыДополнительныеРеквизиты.qvd]
(qvd);

MapСправочникКонтрагентыДополнительныеРеквизитыInternal: 
Mapping Replace LOAD
	[მინიშნება],
    ApplyMap('MapБулево',[მნიშვნელობა],'არა') as [მნიშვნელობა]
Resident СправочникКонтрагентыДополнительныеРеквизитыPre
Where
	ApplyMap('MapПланВидовХарактеристикДополнительныеРеквизитыИСведения',[თვისება],Null()) = 'Internal (2 ერთჯერადი)';

MapСправочникКонтрагентыДополнительныеРеквизитыМенеджерПродаж: 
Mapping Replace LOAD
	[მინიშნება],
    ApplyMap('MapСправочникПользователи',[მნიშვნელობა],null()) as [მნიშვნელობა]
Resident СправочникКонтрагентыДополнительныеРеквизитыPre
Where
	ApplyMap('MapПланВидовХарактеристикДополнительныеРеквизитыИСведения',[თვისება],Null()) = 'გაყიდვების მენეჯ. (2 ერთჯერადი)';

drop table СправочникКонтрагентыДополнительныеРеквизитыPre;



СправочникДоговорыКонтрагентовPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникДоговорыКонтрагентов.qvd]
(qvd);

MapСрокОплатыПокупателя:
Mapping Replace LOAD
    [მინიშნება],
    [მყიდველის გადახდის ვადა]
Resident СправочникДоговорыКонтрагентовPre;

MapНаправленияПокупателейДоговора:
Mapping Replace LOAD
    [მინიშნება],
    ApplyMap('MapПеречислениеНаправленияПокупателей',[მიმართულება],'მიმართულების გარეშე')
Resident СправочникДоговорыКонтрагентовPre;

Drop Table СправочникДоговорыКонтрагентовPre;

// ----- ორგანიზაციის დონის მიმართულების გადაფარვა -----
// 1C-ში [პროექტები] ნიშნიანი ორგანიზაციის (electric) ყველა გაყიდვა კორპორატიულია —
// ხელშეკრულების მიმართულება მასზე არ ითვლება. ორგანიზაციების სია 1C-ის ნიშნიდან მოდის:
// ახალი ორგანიზაცია = ნიშანი 1C-ში, სკრიპტის ცვლილება არ სჭირდება.
// წესი ორგანიზაციაზეა და არა ხელშეკრულებაზე, ამიტომ ზემოთა რუკებში ვერ ჩაჯდება (მათი გასაღები
// ხელშეკრულება/დოკუმენტია): ეს რუკა ᲝᲠᲒᲐᲜᲘᲖᲐᲪᲘᲘᲡ მინიშნებით იკითხება და გამოიყენება იქ,
// სადაც ფაქტს [ორგანიზაცია] ხელთ აქვს — SD 0201 (გაყიდვები) და SD 0202 (დებიტორები).
// გამოძახება ყველგან ერთი და იგივეა: ApplyMap ამ რუკაზე, ᲜᲐᲒულისხმევად კი ძველი გამოსახულება:
//     ApplyMap('MapПереопределениеНаправленияОрганизации',[ორგანიზაცია],<ძველი გამოსახულება>)
// ᲧᲣᲠᲐᲓᲦᲔᲑᲐ: გასაღები [ორგანიზაცია_კონტრაგენტი_პერიოდი_ნაშთია] მიმართულებას ᲨᲔᲘᲪᲐᲕᲡ —
// საჩვენებელი ველი და გასაღები ᲧᲝᲕᲔᲚᲗᲕᲘᲡ ერთად უნდა შეიცვალოს, თორემ ხიდი დაიშლება.
// P&L (SD 0206) გაყიდვების ფაქტიდან კითხულობს მიმართულებას → გადაფარვას ავტომატურად იღებს.
// Replace პრეფიქსი აუცილებელია: SD 0002 ნაწილობრივ გადატვირთვაზეც მუშაობს.
MapПереопределениеНаправленияОрганизации:
Mapping Replace LOAD
    [Ссылка],
    'კორპორატიული'
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникОрганизации.qvd]
(qvd)
Where ApplyMap('MapБулево',[პროექტები],'არა') = 'კი';

// SD-ის ორგანიზაციები (GUID → 'კი'): 1C-ის ნიშანი [გაყიდვების ორგანიზაცია]. ყველა ფაქტი
// (გაყიდვები, დებიტორები, მარაგები, P&L) მხოლოდ ამ ორგანიზაციებს ტვირთავს:
//     ApplyMap('MapОрганизацияПродаж',[ორგანიზაცია],'არა') = 'კი'
// ახალი ორგანიზაცია = ნიშანი 1C-ში. GUID-ები ორივე ბაზაში (SD და 24) ერთნაირია, ამიტომ ერთი
// რუკა 24-ის ბლოკებსაც ემსახურება.
MapОрганизацияПродаж:
Mapping Replace LOAD
    [Ссылка],
    'კი'
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникОрганизации.qvd]
(qvd)
Where ApplyMap('MapБулево',[გაყიდვების ორგანიზაცია],'არა') = 'კი';





ДокументРасходнаяНакладнаяPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_ДокументРасходнаяНакладная-Empty.qvd]
(qvd);

ДокументРасходнаяНакладнаяPre:
Add LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_ДокументРасходнаяНакладная-*.qvd]
(qvd);

MapДокументРасчетыСПокупателем:
Mapping Replace LOAD
	[მინიშნება] AS [%lnk_მინიშნება], //Type: ДокументРасходнаяНакладная,
	Date(DayStart(AddYears([თარიღი],-2000)),'MM/DD/YYYY') AS [თარიღი]
Resident ДокументРасходнаяНакладнаяPre;

MapНаправлениеДокумента:
Mapping Replace LOAD
	[მინიშნება] AS [%lnk_მინიშნება], //Type: ДокументРасходнаяНакладная,
	ApplyMap('MapНаправленияПокупателейДоговора',[ხელშეკრულება],'მიმართულების გარეშე') AS [ხელშეკრულება]
Resident ДокументРасходнаяНакладнаяPre;

MapТипЗадолженностиДокумента:
Mapping Replace LOAD
	[მინიშნება] AS [%lnk_მინიშნება (გასავლის ზედდებული,დოკუმენტი)], //Type: ДокументРасходнаяНакладная,
	ApplyMap('MapПеречислениеТипыЗадолженностей',[დავალიანების ტიპი],'არ არის შევსებული') AS [დავალიანების ტიპი (გასავლის ზედდებული,დოკუმენტი)]
Resident ДокументРасходнаяНакладнаяPre;

MapДокументРасходнаяНакладнаяСклад:
Mapping Replace LOAD
	[მინიშნება],
	[საწყობი]
Resident ДокументРасходнаяНакладнаяPre;

MapДокументРасходнаяНакладнаяАвтор:
Mapping Replace LOAD
	[მინიშნება],
	ApplyMap('MapСправочникПользователи',[ავტორი],Null())
Resident ДокументРасходнаяНакладнаяPre;

MapДокументРасходнаяНакладнаяУчастникКэшбека:
Mapping Replace LOAD
	[მინიშნება],
	[ქეშბექის მონაწილე]
Resident ДокументРасходнаяНакладнаяPre
where 
    not [ქეშბექის მონაწილე] = '00000000000000000000000000000000';

// საპროექტო გაყიდვების გადაფარვის მასალა: დოკუმენტი → განყოფილება + შეკვეთა + საწყობი. რუკა
// ქვემოთ, სტრუქტურული ერთეულების ცნობარის შემდეგ შენდება (სახელით შედარება მას სჭირდება).
// ველის სახელები უნიკალურია, რომ ცხრილი სხვასთან ავტომატურად არ შეერთდეს.
ДокументПроектнойПродажиTemp:
Replace LOAD
	[მინიშნება] AS [_დოკუმენტი (პროექტი)],
	[განყოფილება] AS [_განყოფილება (პროექტი)],
	[შეკვეთა] AS [_შეკვეთა (პროექტი)],
	[საწყობი] AS [_საწყობი (პროექტი)]
Resident ДокументРасходнаяНакладнаяPre;

Drop Table ДокументРасходнаяНакладнаяPre;

ДокументПередачаВАPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_ДокументПередачаВА-Empty.qvd]
(qvd);

ДокументПередачаВАPre:
Add LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_ДокументПередачаВА-*.qvd]
(qvd);

MapДокументРасчетыСПокупателем:
Mapping Add LOAD
	[მინიშნება] AS [%lnk_მინიშნება], //Type: ДокументПередачаВА,
	Date(DayStart(AddYears([თარიღი],-2000)),'MM/DD/YYYY') AS [თარიღი]
Resident ДокументПередачаВАPre;

MapНаправлениеДокумента:
Mapping Replace LOAD
	[მინიშნება] AS [%lnk_მინიშნება], //Type: ДокументПередачаВА,
	ApplyMap('MapНаправленияПокупателейДоговора',[ხელშეკრულება],'მიმართულების გარეშე') AS [ხელშეკრულება]
Resident ДокументПередачаВАPre;

Drop Table ДокументПередачаВАPre;

РегистрСведенийЛимитыКонтрагентовСрезПоследнихPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_РегистрСведенийЛимитыКонтрагентовСрезПоследних-Empty.qvd]
(qvd);

РегистрСведенийЛимитыКонтрагентовСрезПоследнихPre:
Add LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_РегистрСведенийЛимитыКонтрагентовСрезПоследних-*.qvd]
(qvd);

MapЛимитыКонтрагентов:
Mapping Replace LOAD
	[ხელშეკრულება] AS [%lnk_ხელშეკრულება (საკრედიტო ლიმიტები,ინფ. რეგისტრი)], //Type: СправочникДоговорыКонтрагентов,
	Sum([თანხა]) AS [თანხა (საკრედიტო ლიმიტები,ინფ. რეგისტრი)]	
Resident РегистрСведенийЛимитыКонтрагентовСрезПоследнихPre
// where 
//     match(ApplyMap('MapБулево',[აქტიური],Null()),'კი')
group by [ხელშეკრულება];

Drop Table РегистрСведенийЛимитыКонтрагентовСрезПоследнихPre;















 


MapНужныеНаправленияДеятельности:
MAPPING Replace LOAD 
	[Product Direction] as [Product Direction], 
	1 as [Value];
SELECT 
	[Product Direction]
FROM GetWorksheetV2
WITH PROPERTIES (
worksheetKey='1khHxo_6tF2-fj0BWu77QLWC9ODRZOnw4DMteglpaYZc:_1450613259', //Qlik Matching, ActualDirections Sheet
gidOverride='',
generatedNumberedColumns='false',
skipRows=''
);

MapСправочникНаправленияДеятельности:
Mapping Replace LOAD
    [მინიშნება],
    if(APPLYMAP('MapНужныеНаправленияДеятельности', [დასახელება])=1,[დასახელება],'სხვა');
LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникНаправленияДеятельности.qvd]
(qvd);

СправочникСтруктурныеЕдиницыTemp:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникСтруктурныеЕдиницы.qvd]
(qvd);

MapСправочникСтруктурныеЕдиницы:
Mapping Replace LOAD
    [მინიშნება],
    [დასახელება]
Resident СправочникСтруктурныеЕдиницыTemp;

MapСправочникСтруктурныеЕдиницыКод:
Mapping Replace LOAD
    [მინიშნება],
    [კოდი]
Resident СправочникСтруктурныеЕдиницыTemp;

// ლოკაცია (GUID) → დასახელება (ცნობარი Локация)
MapЛокацияНаименование:
Mapping Replace LOAD
    [Ссылка],
    Trim([Наименование])
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникЛокация.qvd]
(qvd);

// ადმინისტრაციის ლოკაცია (გასაღები 1 → დასახელება): 1C-ის ნიშანი [ადმინისტრაცია] ცნობარში
// Локация. [ლოკაცია (გაყიდვები)]-ის default-ია (SD 0201): ApplyMap('MapЛокацияАдминистрация', 1, ...).
// რამდენიმე ნიშნიანიდან რუკა პირველს იტოვებს; არცერთი → გამომძახებლის default.
MapЛокацияАдминистрация:
Mapping Replace LOAD
    1,
    Trim([Наименование])
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникЛокация.qvd]
(qvd)
Where ApplyMap('MapБулево',[ადმინისტრაცია],'არა') = 'კი';

// სტრუქტურული ერთეული (GUID) → მისი ლოკაციის დასახელება (რეკვიზიტი Локация).
// ლოკაციის გარეშე ერთეული რუკაში არ ხვდება — default გამომძახებელზეა.
MapСтруктурнаяЕдиницаЛокация:
Mapping Replace LOAD
    [მინიშნება],
    ApplyMap('MapЛокацияНаименование',[ლოკაცია],'')
Resident СправочникСтруктурныеЕдиницыTemp
Where Len(ApplyMap('MapЛокацияНаименование',[ლოკაცია],'')) > 0;

Drop Table СправочникСтруктурныеЕдиницыTemp;

// ----- დოკუმენტის დონის მიმართულების გადაფარვა: საპროექტო გაყიდვები -----
// ზედდებული საპროექტოა, თუ ᲔᲠᲗ-ᲔᲠᲗᲘ პირობა სრულდება:
//   1. შეკვეთის გაყიდვის სტრუქტურული ერთეული საპროექტო განყოფილებაა;
//   2. ზედდებულის განყოფილება საპროექტო განყოფილებაა;
//   3. ზედდებულის საწყობი საპროექტო საწყობია.
// საპროექტო ზედდებულის ყველა გაყიდვა კორპორატიულია, ხელშეკრულების მიუხედავად.
// P&L-ის (SD 0206) გაყიდვის განყოფილებაც აქედან მოდის (იგივე პრიორიტეტით 1→2→3), ამიტომ
// წესი ერთ ადგილასაა: საპროექტო დოკუმენტი იქ საპროექტო განყოფილებას იღებს → ლოკაცია
// 'პროექტები' (1C: განყოფილების რეკვიზიტი Локация).
// გამოძახება SD 0201-ში ორგანიზაციის გადაფარვის ᲨᲘᲒᲜᲘᲗ (ორივე ადგილას — ველი და გასაღები):
//     ApplyMap('MapПереопределениеНаправленияОрганизации',[ორგანიზაცია],
//         ApplyMap('MapПереопределениеНаправленияДокумента',[დოკუმენტი],<ძველი გამოსახულება>))
// დებიტორებზე ᲐᲠ ედება: გადახდის დოკუმენტს შეკვეთა/განყოფილება არ აქვს, ნაშთები
// მიმართულებებით დაიშლებოდა.
// სიები რუკებია და არა SET-ცვლადი: SET ერთელემენტიან სიას ბრჭყალებს აცლის, და ასეთი სია
// match()-ში ველის სახელად იკითხება.

// საპროექტო განყოფილებები (GUID → 'კი'): ტიპით 'განყოფილება' სტრუქტურული ერთეული 1C-ის
// ნიშნით [პროექტები]. გასაღები GUID-ია — სახელის გადარქმევა წესს არ არღვევს. წაშლის
// ნიშნულიანი ელემენტებიც შედის: მათზე გატარებული ძველი დოკუმენტი საპროექტოდ რჩება.
// SD 0004 (ბიუჯეტი) და SD 0206 (COGS-ბაზა) ამავე რუკას იყენებენ.
MapПроектноеПодразделение:
Mapping Replace LOAD
    [მინიშნება],
    'კი'
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникСтруктурныеЕдиницы.qvd]
(qvd)
Where ApplyMap('MapПеречислениеТипыСтруктурныхЕдиниц',[ტიპი],Null()) = 'განყოფილება'
    and ApplyMap('MapБулево',[პროექტები],'არა') = 'კი';

// საპროექტო საწყობი (GUID → საპროექტო განყოფილების GUID): 1C-ის ნიშნით [პროექტები]
// სტრუქტურული ერთეული, რომელიც განყოფილება არ არის. საწყობის გაყიდვა მისი რეკვიზიტის
// [საპროექტო განყოფილება] გაყიდვად ითვლება. ნიშნიანი საწყობი შევსებული რეკვიზიტის გარეშე
// რუკაში არ ხვდება — ანუ საპროექტოდ ᲐᲠ ითვლება (განყოფილება აუცილებელია P&L-ისთვის).
// წაშლის ნიშნულიანი ელემენტებიც შედის: ძველი დოკუმენტი საპროექტოდ რჩება.
MapПроектныйСклад:
Mapping Replace LOAD
    [მინიშნება],
    [საპროექტო განყოფილება]
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_СправочникСтруктурныеЕдиницы.qvd]
(qvd)
Where ApplyMap('MapБулево',[პროექტები],'არა') = 'კი'
    and not ApplyMap('MapПеречислениеТипыСтруктурныхЕдиниц',[ტიპი],'') = 'განყოფილება'
    and Len(Trim([საპროექტო განყოფილება])) > 0
    and not [საპროექტო განყოფილება] = '00000000000000000000000000000000';

// შეკვეთა → გაყიდვის სტრუქტურული ერთეული (GUID)
MapЗаказЕдиницаПродажи:
Mapping Replace LOAD
    [მინიშნება],
    [განყოფილება]
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_ДокументЗаказПокупателя-*.qvd]
(qvd);

// დოკუმენტი → საპროექტო განყოფილების GUID; ცარიელი = დოკუმენტი საპროექტო არ არის.
ДокументПроектнойПродажиЕдиницаTemp:
Replace LOAD
    [_დოკუმენტი (პროექტი)],
    if(ApplyMap('MapПроектноеПодразделение',
            ApplyMap('MapЗаказЕдиницаПродажи',[_შეკვეთა (პროექტი)],''),'არა') = 'კი',
        ApplyMap('MapЗаказЕдиницаПродажи',[_შეკვეთა (პროექტი)],''),
    if(ApplyMap('MapПроектноеПодразделение',[_განყოფილება (პროექტი)],'არა') = 'კი',
        [_განყოფილება (პროექტი)],
        ApplyMap('MapПроектныйСклад',[_საწყობი (პროექტი)],''))) AS [_ერთეული (პროექტი)]
Resident ДокументПроектнойПродажиTemp;

MapПереопределениеНаправленияДокумента:
Mapping Replace LOAD
    [_დოკუმენტი (პროექტი)],
    'კორპორატიული' AS [_მიმართულება (პროექტი)]
Resident ДокументПроектнойПродажиЕдиницаTemp
Where Len([_ერთეული (პროექტი)]) > 0;

// P&L-ისთვის (SD 0206): დოკუმენტი → საპროექტო განყოფილების GUID
MapПроектнаяПродажаПодразделение:
Mapping Replace LOAD
    [_დოკუმენტი (პროექტი)],
    [_ერთეული (პროექტი)]
Resident ДокументПроектнойПродажиЕдиницаTemp
Where Len([_ერთეული (პროექტი)]) > 0;

// გაყიდვის განყოფილება (GUID) [ლოკაცია (გაყიდვები)]-სთვის (SD 0201): საპროექტო დოკუმენტზე —
// მისი საპროექტო განყოფილება, დანარჩენზე — ზედდებულის განყოფილება.
MapДокументПодразделениеПродажи:
Mapping Replace LOAD
    [_დოკუმენტი (პროექტი)],
    ApplyMap('MapПроектнаяПродажаПодразделение',[_დოკუმენტი (პროექტი)],[_განყოფილება (პროექტი)])
Resident ДокументПроектнойПродажиTemp;

// [ლოკაცია (გაყიდვები)]: ამ თარიღიდან განყოფილების ლოკაცია, მანამდე — საწყობისა (SD 0201).
LET vSalesLocationDeptFrom = Num(MakeDate(2026,1,1));

Drop Tables ДокументПроектнойПродажиTemp, ДокументПроектнойПродажиЕдиницаTemp;









MapКоэффициентыДнейPre:
Replace LOAD 
	[თარიღი],
	[კოეფიციენტი];

SELECT [თარიღი],
	[კოეფიციენტი]
FROM GetWorksheetV2
WITH PROPERTIES (
worksheetKey='1-f15L80uaVKbMAD786Bp5NHDQlr7IqxFHhQoIBosNWA:_165959605',
gidOverride='',
generatedNumberedColumns='false',
skipRows=''
);

MapВыходныеПоМесяцам:
Mapping Replace Load 
	MonthStart(Date#([თარიღი],'YYYY-MM-DD')) as [თარიღი],
	sum(1-[კოეფიციენტი]) as Value
Resident MapКоэффициентыДнейPre
group by MonthStart(Date#([თარიღი],'YYYY-MM-DD'));

MapВыходныеПоДням:
Mapping Replace Load 
	Date#([თარიღი],'YYYY-MM-DD') as [თარიღი],
	[კოეფიციენტი] as Value
Resident MapКоэффициентыДнейPre;

Drop Table MapКоэффициентыДнейPre;

РегистрСведенийДанныеДляРасчетаРоялтиPre:
Replace LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_РегистрСведенийДанныеДляРасчетаРоялти-Empty.qvd]
(qvd);

РегистрСведенийДанныеДляРасчетаРоялтиPre:
Add LOAD
    *
FROM [lib://$(vSpace):DataFiles/$(vSpacePrefix)_$(vPrefix)_РегистрСведенийДанныеДляРасчетаРоялти-*.qvd]
(qvd);

MapРегистрСведенийДанныеДляРасчетаРоялти:
Mapping Replace LOAD
	floor(Date(monthend(AddYears([Период],-2000)),'DD/MM/YYYY HH:mm:ss')) AS RoyaltyDate,
	[ფაქტიური მონაცემები] AS [ფაქტიური მონაცემები (როიალტის გაანგარიშების მონაცემები)]
Resident РегистрСведенийДанныеДляРасчетаРоялтиPre;

Drop Table РегистрСведенийДанныеДляРасчетаРоялтиPre;